<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="#FF1A1A2E">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lilly AI Companion"
        android:textSize="28sp"
        android:textColor="#FF6B9CE3"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v2.2"
        android:textSize="16sp"
        android:textColor="#FF4ADE80"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/startOverlay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Start Lilly Overlay"
        android:textSize="16sp"
        android:backgroundTint="#FF4ADE80"
        android:textColor="#FF000000"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/stopOverlay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Stop Lilly Overlay"
        android:textSize="16sp"
        android:backgroundTint="#FFFF9AA5"
        android:textColor="#FF000000"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/openSettings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="App Permissions"
        android:textSize="16sp"
        android:backgroundTint="#FF60A5FA"
        android:textColor="#FFFFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Requires: Overlay, Microphone, Notifications"
        android:textSize="12sp"
        android:textColor="#FF888888"
        android:gravity="center"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Default server: http://100.93.131.114:8098"
        android:textSize="12sp"
        android:textColor="#FF888888"
        android:gravity="center" />

</LinearLayout>
