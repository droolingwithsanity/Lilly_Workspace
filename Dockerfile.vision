###############################################
# Lilly Vision Server — Standalone YOLOv8
# Multi-agent commentary with Edge TTS
###############################################
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg ca-certificates curl libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir \
    fastapi uvicorn numpy \
    opencv-python-headless \
    ultralytics \
    faiss-cpu \
    edge-tts \
    httpx \
    mediapipe

# Runtime ONNX engine for SCRFD + ArcFace (face recognition) and the
# vehicle make/model classifier (kept separate so the big
# ultralytics/torch layer stays cached)
RUN pip install --no-cache-dir onnxruntime

# Copy YOLO model (prefer Open Images V7 for 601 classes)
COPY yolov8n-oiv7.pt .
COPY yunet.onnx .

# Copy vision server + face recognition + person tracker + node registry + blink detector
COPY yolov8_vision_server.py .
COPY face_recognition_engine.py .
COPY person_tracker.py .
COPY node_registry.py .
COPY blink_detector.py .
COPY car_classifier.py .
COPY car_labels.txt .

EXPOSE 8198

CMD ["python3", "yolov8_vision_server.py"]
