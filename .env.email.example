# Open Connector Configuration for Lilly AI Email Integration
# Copy this to .env and fill in your values

# Open Connector Settings
OPENCONNECTOR_URL=http://connector:3000
OPENCONNECTOR_RUNTIME_TOKEN=oct_your_runtime_token_here
OPENCONNECTOR_ORIGIN=http://localhost:3000
OPENCONNECTOR_ENCRYPTION_KEY=your_encryption_key_here
OPENCONNECTOR_ADMIN_TOKEN=your_admin_token_here

# SSO Configuration (for user authentication and session management)
JWT_SECRET=your_jwt_secret_here_generate_with_openssl_rand_hex_32
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=30

# Gmail OAuth Configuration (create in Google Cloud Console)
# 1. Go to https://console.cloud.google.com
# 2. Create OAuth 2.0 credentials
# 3. Add http://localhost:3000/oauth/callback as redirect URI
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret

# Outlook OAuth Configuration (create in Azure Portal)
# 1. Go to https://portal.azure.com
# 2. Register an application
# 3. Add http://localhost:3000/oauth/callback as redirect URI
OUTLOOK_CLIENT_ID=your_outlook_client_id
OUTLOOK_CLIENT_SECRET=your_outlook_client_secret

# Optional: Restrict allowed actions (comma-separated)
# OPENCONNECTOR_ALLOWED_ACTIONS=gmail.*,outlook.*

# Optional: Block specific actions (comma-separated)
# OPENCONNECTOR_BLOCKED_ACTIONS=gmail.delete_label

# Optional: Allowed proxy hosts
# OPENCONNECTOR_ALLOWED_PROXIES=

# Optional: Blocked proxy hosts  
# OPENCONNECTOR_BLOCKED_PROXIES=

# ─── Auth0 Configuration ──────────────────────────────────────────
# Replace the admin-token auth with Auth0 for individual user sessions.
# 1. Create an app at https://manage.auth0.com
# 2. Set Allowed Callback URLs: http://your-host:8098/api/auth0/callback
# 3. Set Allowed Logout URLs: http://your-host:8098
# 4. Copy the Domain, Client ID, Client Secret below
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
# Generate with: openssl rand -hex 32
AUTH0_SECRET=a_64_char_hex_string_used_to_encrypt_session_cookies
# The public URL of this server (must match Auth0 callback config)
APP_BASE_URL=http://your-host:8098
# Optional: comma-separated emails of admin users (gets full permissions)
# AUTH0_ADMIN_EMAILS=admin@example.com,owner@example.com
