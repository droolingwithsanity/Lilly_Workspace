<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press quick actions menu — shown as a horizontal scrollable strip above the overlay -->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="@drawable/overlay_action_button_bg"
        android:elevation="8dp">

        <!-- Chat / Expand -->
        <LinearLayout
            android:id="@+id/lillyQuickChat"
            android:layout_width="52dp"
            android:layout_height="56dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textSize="9sp"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <!-- Mic toggle -->
        <LinearLayout
            android:id="@+id/lillyQuickMic"
            android:layout_width="52dp"
            android:layout_height="56dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/lillyMicIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎤"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/lillyMicLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mic"
                android:textSize="9sp"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <!-- Transcript -->
        <LinearLayout
            android:id="@+id/lillyQuickTranscript"
            android:layout_width="52dp"
            android:layout_height="56dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transcript"
                android:textSize="9sp"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <!-- Avatar picker -->
        <LinearLayout
            android:id="@+id/lillyQuickAvatar"
            android:layout_width="52dp"
            android:layout_height="56dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/lillyAvatarIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐶"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avatar"
                android:textSize="9sp"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <!-- Share pairing code -->
        <LinearLayout
            android:id="@+id/lillyQuickPairing"
            android:layout_width="52dp"
            android:layout_height="56dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔗"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pair"
                android:textSize="9sp"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            android:id="@+id/lillyQuickSettings"
            android:layout_width="52dp"
            android:layout_height="56dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="9sp"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <!-- Mode toggle (local ↔ online) -->
        <LinearLayout
            android:id="@+id/lillyQuickMode"
            android:layout_width="52dp"
            android:layout_height="56dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/lillyModeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mode"
                android:textSize="9sp"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <!-- Minimize (collapse but keep running) -->
        <LinearLayout
            android:id="@+id/lillyQuickMinimize"
            android:layout_width="52dp"
            android:layout_height="56dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="➖"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minimize"
                android:textSize="9sp"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <!-- Close overlay -->
        <LinearLayout
            android:id="@+id/lillyQuickClose"
            android:layout_width="52dp"
            android:layout_height="56dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textSize="20sp"
                android:textColor="#FFFF9AA5" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Close"
                android:textSize="9sp"
                android:textColor="#FFFF9AA5" />
        </LinearLayout>

    </LinearLayout>
</HorizontalScrollView>
