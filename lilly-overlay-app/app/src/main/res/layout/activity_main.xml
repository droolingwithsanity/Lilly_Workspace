<?xml version="1.0" encoding="utf-8"?>
<!-- Simplified main activity — overlay relay only, no Auth0 / local AI -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_frosty_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lilly AI Companion"
            android:textSize="28sp"
            android:textColor="#5D4E6D"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/appVersionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_version"
            android:textSize="16sp"
            android:textColor="#4ADE80"
            android:layout_marginBottom="8dp" />

        <!-- Overlay Controls -->
        <Button
            android:id="@+id/startOverlay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/app_name"
            android:textSize="16sp"
            android:backgroundTint="#4ADE80"
            android:textColor="#000000"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/stopOverlay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Stop Lilly Overlay"
            android:textSize="16sp"
            android:backgroundTint="#F472B6"
            android:textColor="#000000"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/openSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="App Permissions"
            android:textSize="16sp"
            android:backgroundTint="#7DD3FC"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Requires: Overlay, Microphone, Notifications"
            android:textSize="11sp"
            android:textColor="#7D4E6D"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Get Phone App (APK Download) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#5D4E6D33"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lilly Phone App"
            android:textSize="14sp"
            android:textColor="#5D4E6D"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share this APK with another phone or re-install the latest build."
            android:textSize="11sp"
            android:textColor="#5D4E6D80"
            android:layout_marginBottom="12dp" />

        <!-- Recent Changes -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#5D4E6D33"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recent_changes_title"
            android:textSize="14sp"
            android:textColor="#5D4E6D"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recent_changes_1"
            android:textSize="11sp"
            android:textColor="#5D4E6D80"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recent_changes_2"
            android:textSize="11sp"
            android:textColor="#5D4E6D80"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recent_changes_3"
            android:textSize="11sp"
            android:textColor="#5D4E6D80"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recent_changes_4"
            android:textSize="11sp"
            android:textColor="#5D4E6D80"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recent_changes_5"
            android:textSize="11sp"
            android:textColor="#5D4E6D80"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recent_changes_6"
            android:textSize="11sp"
            android:textColor="#5D4E6D80"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recent_changes_7"
            android:textSize="11sp"
            android:textColor="#5D4E6D80"
            android:layout_marginBottom="2dp" />

    </LinearLayout>
</ScrollView>
