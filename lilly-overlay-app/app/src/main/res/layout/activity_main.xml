<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lilly AI"
            android:textSize="24sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/appVersionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_version"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="24dp" />

        <!-- Permissions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PERMISSIONS"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Grant all permissions"
                android:textSize="15sp"
                android:textColor="?android:attr/textColorPrimary" />

            <Button
                android:id="@+id/btnGrantAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Grant"
                android:textSize="12sp"
                android:backgroundTint="?android:attr/colorPrimary"
                android:textColor="?android:attr/textColorPrimaryInverse" />
        </LinearLayout>

        <TextView
            android:id="@+id/permissionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checking permissions..."
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="16dp"
            android:paddingStart="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="16dp" />

        <!-- Pairing -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PAIRING"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pair with Web UI"
                android:textSize="15sp"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

        <EditText
            android:id="@+id/pairCodeInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:inputType="number"
            android:maxLength="6"
            android:hint="Enter 6-digit code from Web UI"
            android:textSize="18sp"
            android:textColor="?android:attr/textColorPrimary"
            android:background="?android:attr/editTextBackground"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/pairServerUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:inputType="textUri"
            android:hint="Server URL (e.g. http://100.93.131.114:8098)"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:background="?android:attr/editTextBackground"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btnSubmitPair"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Pair"
            android:textSize="14sp"
            android:backgroundTint="?android:attr/colorPrimary"
            android:textColor="?android:attr/textColorPrimaryInverse"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/pairStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Not paired"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="16dp"
            android:paddingStart="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
