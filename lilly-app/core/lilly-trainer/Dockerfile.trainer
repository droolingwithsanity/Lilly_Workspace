###############################################
# YOLO Self-Training Agent
# Build context: lilly-app/  (dockerfile: core/lilly-trainer/Dockerfile.trainer)
###############################################
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY core/lilly-trainer/requirements.txt .
RUN pip install --no-cache-dir \
    fastapi uvicorn numpy \
    opencv-python-headless \
    ultralytics \
    pyyaml \
    httpx \
    "scrapling[all]>=0.4.14" \
    beautifulsoup4 \
    lxml

# Install Playwright/Chromium browsers for Scrapling stealth fetcher
RUN python3 -c "from scrapling.fetchers import StealthyFetcher; print('stealthy OK')" \
    && python3 -m pip show scrapling | head -2 \
    && (scrapling install --force || SCRAPLING_NO_PYTEST=1 python3 -c "import scrapling, os; os.system('playwright install chromium chromium-headless-shell ffmpeg')" || echo "browser install skipped")

# Copy training agent files
COPY core/lilly-trainer/yolo_self_trainer.py .
COPY core/lilly-trainer/yolo_trainer_api.py .
COPY core/lilly-trainer/photo_training_bridge.py .
COPY core/lilly-trainer/instagram_scraper.py .

# Create training data directories
RUN mkdir -p training_data/{samples,images,dataset,models,instagram}

EXPOSE 8199

CMD ["python3", "-m", "uvicorn", "yolo_trainer_api:app", "--host", "0.0.0.0", "--port", "8199"]