<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LillyAssistant" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        
        <!-- Background and surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorError">@color/error</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/surface</item>
        
        <!-- Action bar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        
        <!-- Ripple effect -->
        <item name="colorControlHighlight">@color/primary_light</item>
        
        <!-- Card view -->
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        
        <!-- Button styles -->
        <item name="materialButtonStyle">@style/Widget.Lilly.Button</item>
        
        <!-- Text input layout -->
        <item name="textInputStyle">@style/Widget.Lilly.TextInputLayout</item>
        
        <!-- Switch style -->
        <item name="switchStyle">@style/Widget.Lilly.Switch</item>
    </style>
</resources>