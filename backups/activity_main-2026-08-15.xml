<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#cfcfcf"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Title bar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/beos_titlepill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingTop="4dp"
            android:paddingRight="8dp"
            android:paddingBottom="4dp">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/beos_title_button_bg" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/beos_title_button_bg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="@string/settings_title"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/beos_title_button_bg" />
        </LinearLayout>

        <!-- Settings body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-1dp"
            android:background="@drawable/beos_window_body_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Pairing Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_pairing_section"
                android:textColor="#1f3552"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/pairTokenLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_pair_token_label"
                    android:textColor="#1f1f1f"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/copyPairTokenButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/beos_button_bg"
                    android:text="@string/settings_copy_token"
                    android:textAllCaps="false"
                    android:textColor="#111111"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/pairTokenValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#f4f4f4"
                android:padding="8dp"
                android:text="@string/settings_pair_token_placeholder"
                android:textColor="#1f1f1f"
                android:textSize="12sp"
                android:typeface="monospace"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/pairWithServerButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/beos_button_bg_pink"
                    android:text="@string/settings_pair_with_server"
                    android:textAllCaps="true"
                    android:textColor="#111111" />

                <Button
                    android:id="@+id/testPairingButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/beos_button_bg"
                    android:text="@string/settings_test_pairing"
                    android:textAllCaps="true"
                    android:textColor="#111111" />
            </LinearLayout>

            <TextView
                android:id="@+id/pairingStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#efe7d1"
                android:padding="6dp"
                android:text="@string/settings_pairing_status_idle"
                android:textColor="#1f3552"
                android:textSize="12sp"
                android:layout_marginBottom="16dp" />

            <!-- Termux Bridge Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_termux_section"
                android:textColor="#1f3552"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/termuxStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#efe7d1"
                android:padding="6dp"
                android:text="@string/settings_termux_status_checking"
                android:textColor="#1f3552"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/termuxPermissionButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/beos_button_bg"
                    android:text="@string/settings_termux_permission"
                    android:textAllCaps="true"
                    android:textColor="#111111" />

                <Button
                    android:id="@+id/termuxExternalAppsButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/beos_button_bg"
                    android:text="@string/settings_termux_external_apps"
                    android:textAllCaps="true"
                    android:textColor="#111111" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/termuxTestButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/beos_button_bg_pink"
                    android:text="@string/settings_termux_test"
                    android:textAllCaps="true"
                    android:textColor="#111111" />

                <Button
                    android:id="@+id/termuxCopySetupButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/beos_button_bg"
                    android:text="@string/settings_termux_copy_setup"
                    android:textAllCaps="true"
                    android:textColor="#111111" />
            </LinearLayout>

            <TextView
                android:id="@+id/termuxBridgeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#f4f4f4"
                android:padding="6dp"
                android:text="@string/settings_termux_bridge_idle"
                android:textColor="#1f1f1f"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/termuxSetupHelpText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_termux_help"
                android:textColor="#5f3b3b"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/termuxSetupCommandText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#f4f4f4"
                android:padding="8dp"
                android:textColor="#111111"
                android:textIsSelectable="true"
                android:textSize="12sp"
                android:typeface="monospace"
                android:visibility="gone" />

            <!-- Latest Version -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="#b0b0b0"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_latest_version"
                    android:textColor="#1f1f1f"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/downloadApkButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/beos_button_bg_pink"
                    android:text="@string/settings_download_apk"
                    android:textAllCaps="true"
                    android:textColor="#111111" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
