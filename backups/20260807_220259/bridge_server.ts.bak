import { serve } from "@hono/node-server";
import { Hono } from "hono";
import { cors } from "hono/cors";

const app = new Hono();
app.use("*", cors({ origin: "*" }));

// Lilly AI backend URL
const LILLY_AI_URL = process.env.LILLY_AI_URL || "http://localhost:8098";
const LILLY_SENSOR_URL = process.env.LILY_SENSOR_URL || "http://100.115.234.87:8099";

// Health check
app.get("/health", (c) => c.json({
  ok: true,
  service: "lilly-bridge",
  lilly_ai: LILLY_AI_URL,
  sensors: LILLY_SENSOR_URL
}));

// Chat endpoint - bridges OpenLive web to Lilly AI.
// OpenLive sends {message, avatar, mode, characters} and we forward to
// Lilly AI's /api/cmd endpoint which supports avatar-specific conversation
// with on-device Piper TTS (22050 Hz, 16-bit PCM).
app.post("/chat", async (c) => {
  const body = await c.req.json().catch(() => null);
  const { message, avatar, mode, characters, frames } = body || {};

  if (!message) return c.json({ error: "message required" }, 400);

  // Build vision context if camera frames are included
  let visionContext = "";
  if (frames && frames.length > 0) {
    visionContext = "\n[User is showing you something through their camera]";
  }

  // Forward to Lilly AI's /api/cmd endpoint
  const response = await fetch(`${LILLY_AI_URL}/api/cmd`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      text: message + visionContext,
      avatar: avatar || "puppy",
      source: "openlive",
    })
  });

  if (!response.ok) {
    const data = await response.json().catch(() => null);
    return c.json({ error: data?.error || `HTTP ${response.status}` }, response.status);
  }

  const data = await response.json();

  // Map Lilly AI's /api/cmd response to OpenLive's expected format
  return c.json({
    text: data.reply || "",
    avatar: avatar || "puppy",
    mood: "calm",
    audio_id: data.audio_id || 0,
  });
});

// Get sensor data for voice context
app.get("/sensors", async (c) => {
  try {
    const response = await fetch(`${LILLY_SENSOR_URL}/sensors/all`);
    const data = await response.json();
    return c.json(data);
  } catch (error) {
    return c.json({ error: "Sensor server unavailable" }, 503);
  }
});

// Get battery status
app.get("/battery", async (c) => {
  try {
    const response = await fetch(`${LILLY_SENSOR_URL}/battery`);
    const data = await response.json();
    return c.json(data);
  } catch (error) {
    return c.json({ error: "Sensor server unavailable" }, 503);
  }
});

// Get notifications
app.get("/notifications", async (c) => {
  try {
    const response = await fetch(`${LILLY_SENSOR_URL}/notification/list`);
    const data = await response.json();
    return c.json(data);
  } catch (error) {
    return c.json({ error: "Sensor server unavailable" }, 503);
  }
});

// Piper TTS — bridges OpenLive web to Lilly AI's Piper voice models.
// The web app calls /api/voice/tts/piper (proxied by the web Next route),
// which the bridge forwards here, then we forward to Lilly AI's backend.
app.post("/tts/piper", async (c) => {
  const body = await c.req.json().catch(() => null);
  const { text, voice, speed } = body || {};
  if (!text) return c.json({ error: "text required" }, 400);

  try {
    const response = await fetch(`${LILLY_AI_URL}/api/tts/piper`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        text: text.trim(),
        char_key: voice || "puppy",
        speed: speed || 1.0,
      }),
    });

    if (!response.ok) {
      const data = await response.json().catch(() => null);
      return c.json({ error: data?.error || `HTTP ${response.status}` }, response.status);
    }

    // Piper returns raw 16-bit PCM at 22050 Hz
    const buf = await response.arrayBuffer();
    return new Response(buf, {
      headers: {
        "Content-Type": "application/octet-stream",
        "x-sample-rate": "22050",
        "x-format": "s16le",
        "Access-Control-Expose-Headers": "x-sample-rate, x-format",
      },
    });
  } catch (error) {
    return c.json({ error: "TTS service unavailable" }, 503);
  }
});

const port = Number(process.env.BRIDGE_PORT ?? 8788);
const host = process.env.BRIDGE_HOST?.trim() || "0.0.0.0";

serve({ fetch: app.fetch, port, hostname: host }, () => {
  console.log(`▸ Lilly Bridge listening on http://${host}:${port}`);
  console.log(`  → Forwarding to Lilly AI: ${LILLY_AI_URL}`);
  console.log(`  → Forwarding to Sensors: ${LILLY_SENSOR_URL}`);
});
