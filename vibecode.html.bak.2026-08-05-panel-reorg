<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=coverage">
<title>DroolingWithSanity — VibeCode</title>
<style>
:root{
  --frost-bg:rgba(240,230,239,0.78);
  --frost-surface:rgba(255,255,255,0.55);
  --frost-border:rgba(93,78,109,0.18);
  --frost-glow:rgba(139,122,158,0.22);
  --accent:#8b7a9e;
  --accent2:#8b7a9e;
  --green:#3a8a6a;
  --red:#c05555;
  --yellow:#b58900;
  --text:#5d4e6d;
  --text-dim:rgba(93,78,109,0.55);
  --radius:14px;
  --chat-w:380px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{
  background:linear-gradient(135deg,#f5d5e0 0%,#f0e6ef 45%,#d5f0e6 100%);
  color:var(--text);
  font-family:'Segoe UI',system-ui,-apple-system,sans-serif;
  height:100vh;overflow:hidden;
  display:flex;flex-direction:column;
}

/* ── Frost window base ── */
.frost{
  background:var(--frost-bg);
  backdrop-filter:blur(24px) saturate(1.4);
  -webkit-backdrop-filter:blur(24px) saturate(1.4);
  border:1px solid var(--frost-border);
  border-radius:var(--radius);
  box-shadow:0 8px 40px rgba(0,0,0,0.55),0 0 0 1px rgba(255,255,255,0.04) inset;
}

/* ── Top bar ── */
#topbar{
  display:flex;align-items:center;gap:12px;
  padding:10px 16px;
  background:rgba(240,230,239,0.92);
  border-bottom:1px solid var(--frost-border);
  flex-shrink:0;
  z-index:100;
}
#topbar .logo{font-size:15px;font-weight:700;color:var(--accent);letter-spacing:.5px;white-space:nowrap}
#topbar .logo span{color:var(--text-dim);font-weight:400}
#project-select{
  flex:1;max-width:260px;
  background:var(--frost-surface);
  border:1px solid var(--frost-border);
  color:var(--text);
  border-radius:9px;padding:6px 10px;font-size:13px;outline:none;
}
#project-select option{background:#f0e6ef;color:#5d4e6d}
.topbtn{
  background:var(--frost-surface);border:1px solid var(--frost-border);
  color:var(--text-dim);border-radius:9px;padding:6px 12px;
  font-size:12px;cursor:pointer;transition:all .2s;white-space:nowrap;
}
.topbtn:hover{background:rgba(167,139,250,0.15);color:var(--accent);border-color:rgba(167,139,250,0.3)}
.topbtn.danger:hover{background:rgba(248,113,113,0.15);color:var(--red);border-color:rgba(248,113,113,0.3)}
.topbtn.success{background:rgba(74,222,128,0.12);color:var(--green);border-color:rgba(74,222,128,0.3)}
#status-dot{width:8px;height:8px;border-radius:50%;background:var(--text-dim);flex-shrink:0;transition:background .3s}
#status-dot.running{background:var(--green);box-shadow:0 0 6px var(--green)}
#status-dot.building{background:var(--yellow);box-shadow:0 0 6px var(--yellow);animation:pulse .8s infinite}
#status-dot.error{background:var(--red);box-shadow:0 0 6px var(--red)}
#status-label{font-size:11px;color:var(--text-dim);white-space:nowrap}
#project-url{font-size:11px;color:var(--accent2);text-decoration:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:200px}
#project-url:hover{color:var(--accent)}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

/* ── Main layout ── */
#main{
  display:flex;flex:1;overflow:hidden;
  gap:0;
}

/* ── File manager sidebar ── */
#sidebar{
  width:220px;flex-shrink:0;
  display:flex;flex-direction:column;
  border-right:1px solid var(--frost-border);
  overflow:hidden;
  transition:width .25s ease;
}
#sidebar.collapsed{width:0;border-right:none}
#sidebar-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 12px;border-bottom:1px solid var(--frost-border);
  background:rgba(255,255,255,0.03);flex-shrink:0;
}
#sidebar-header span{font-size:11px;font-weight:600;color:var(--text-dim);letter-spacing:.5px;text-transform:uppercase}
#sidebar-header button{background:none;border:none;color:var(--text-dim);cursor:pointer;font-size:14px;padding:0 2px;line-height:1}
#sidebar-header button:hover{color:var(--accent)}
#file-tree{flex:1;overflow-y:auto;padding:6px 4px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.1) transparent}
.ftree-item{
  display:flex;align-items:center;gap:6px;
  padding:5px 8px;border-radius:8px;cursor:pointer;
  font-size:12px;color:var(--text);
  transition:background .15s;white-space:nowrap;overflow:hidden;
}
.ftree-item:hover{background:rgba(255,255,255,.06)}
.ftree-item.active{background:rgba(167,139,250,.18);color:var(--accent)}
.ftree-item .icon{font-size:13px;flex-shrink:0;width:16px;text-align:center}
.ftree-item .name{overflow:hidden;text-overflow:ellipsis;flex:1}
.ftree-item .size{font-size:10px;color:var(--text-dim);flex-shrink:0}
.ftree-dir{color:var(--accent2)}
.ftree-back{color:var(--text-dim);font-style:italic}

/* ── Editor area ── */
#editor-wrap{
  flex:1;display:flex;flex-direction:column;overflow:hidden;
  min-width:0;
}
#editor-tabs{
  display:flex;align-items:center;gap:0;
  background:rgba(255,255,255,.03);
  border-bottom:1px solid var(--frost-border);
  overflow-x:auto;flex-shrink:0;
  scrollbar-width:none;
}
#editor-tabs::-webkit-scrollbar{display:none}
.etab{
  display:flex;align-items:center;gap:6px;
  padding:8px 14px;font-size:12px;cursor:pointer;
  border-right:1px solid var(--frost-border);
  color:var(--text-dim);white-space:nowrap;
  transition:background .15s,color .15s;flex-shrink:0;
}
.etab:hover{background:rgba(255,255,255,.05);color:var(--text)}
.etab.active{background:rgba(167,139,250,.12);color:var(--accent);border-bottom:2px solid var(--accent)}
.etab .close{font-size:11px;padding:0 2px;border-radius:3px;opacity:.4}
.etab .close:hover{opacity:1;background:rgba(248,113,113,.2);color:var(--red)}
.etab .dirty{color:var(--yellow);font-size:10px}
#editor-toolbar{
  display:flex;align-items:center;gap:8px;
  padding:6px 12px;border-bottom:1px solid var(--frost-border);
  background:rgba(255,255,255,.02);flex-shrink:0;
}
#editor-toolbar .einfo{font-size:11px;color:var(--text-dim);flex:1}
#editor-toolbar button{
  background:var(--frost-surface);border:1px solid var(--frost-border);
  color:var(--text-dim);border-radius:7px;padding:4px 10px;font-size:11px;cursor:pointer;transition:all .2s;
}
#editor-toolbar button:hover{background:rgba(167,139,250,.15);color:var(--accent);border-color:rgba(167,139,250,.3)}
#editor-toolbar .save-btn.dirty{color:var(--yellow);border-color:rgba(251,191,36,.4)}
#editor-box{flex:1;position:relative;overflow:hidden}
#code-editor{
  width:100%;height:100%;
  background:transparent;border:none;outline:none;resize:none;
  color:var(--text);font-family:'JetBrains Mono','Fira Code','Cascadia Code',Consolas,monospace;
  font-size:13px;line-height:1.6;padding:16px;
  tab-size:2;
  scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.1) transparent;
}
#code-editor::selection{background:rgba(167,139,250,.28)}
#editor-placeholder{
  position:absolute;inset:0;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:12px;pointer-events:none;
}
#editor-placeholder .ph-icon{font-size:48px;opacity:.2}
#editor-placeholder .ph-text{font-size:13px;color:var(--text-dim);text-align:center;line-height:1.6}

/* ── Chat panel (frost window, right side) ── */
#chat-panel{
  width:var(--chat-w);flex-shrink:0;
  display:flex;flex-direction:column;
  border-left:1px solid var(--frost-border);
  transition:width .25s ease;
  overflow:hidden;
}
#chat-panel.reduced{width:48px}
#chat-panel.hidden{width:0;border-left:none}
#chat-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 12px;border-bottom:1px solid var(--frost-border);
  background:rgba(255,255,255,.03);flex-shrink:0;
}
#chat-header .title{font-size:12px;font-weight:600;color:var(--accent);letter-spacing:.3px;white-space:nowrap;overflow:hidden}
.chat-controls{display:flex;gap:4px;flex-shrink:0}
.chat-ctrl-btn{
  background:none;border:1px solid var(--frost-border);
  color:var(--text-dim);border-radius:7px;width:26px;height:26px;
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;font-size:13px;transition:all .2s;
}
.chat-ctrl-btn:hover{background:rgba(167,139,250,.15);color:var(--accent);border-color:rgba(167,139,250,.3)}
#chat-panel.reduced #chat-header .title{display:none}
#chat-panel.reduced .chat-ctrl-btn.non-reduce{display:none}
#chat-messages{
  flex:1;overflow-y:auto;padding:12px;
  display:flex;flex-direction:column;gap:8px;
  scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.1) transparent;
}
#chat-panel.reduced #chat-messages,
#chat-panel.reduced #chat-input-row,
#chat-panel.reduced #chat-context-bar{display:none}
.cmsg{border-radius:10px;padding:9px 12px;font-size:12px;line-height:1.55;max-width:100%;word-break:break-word}
.cmsg.user{background:rgba(167,139,250,.18);color:var(--accent);align-self:flex-end;margin-left:16px}
.cmsg.assistant{background:var(--frost-surface);color:var(--text);border:1px solid var(--frost-border)}
.cmsg.system{background:rgba(74,222,128,.08);color:rgba(74,222,128,.8);font-size:11px;font-style:italic;border:1px solid rgba(74,222,128,.15)}
.cmsg pre{background:rgba(0,0,0,.35);border-radius:6px;padding:8px;margin-top:6px;overflow-x:auto;font-size:11px}
.cmsg code{font-family:'JetBrains Mono',monospace;font-size:11px}
.cmsg-sender{display:flex;align-items:center;gap:5px;font-size:10px;font-weight:700;color:var(--accent);margin-bottom:3px}
.cmsg-alpha{font-size:8px;font-weight:800;letter-spacing:.5px;text-transform:uppercase;background:rgba(167,139,250,.22);color:var(--accent);border-radius:5px;padding:1px 5px}
.apply-btn{
  margin-top:6px;background:rgba(167,139,250,.18);border:1px solid rgba(167,139,250,.3);
  color:var(--accent);border-radius:7px;padding:4px 10px;font-size:11px;cursor:pointer;transition:all .2s;
}
.apply-btn:hover{background:rgba(167,139,250,.3)}
#chat-context-bar{
  padding:6px 10px;border-bottom:1px solid var(--frost-border);
  background:rgba(255,255,255,.02);
  display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text-dim);
  flex-shrink:0;
}
#chat-context-bar .ctx-file{color:var(--accent2);font-family:monospace;font-size:10px;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#chat-context-bar input[type=checkbox]{accent-color:var(--accent)}
#chat-input-row{
  display:flex;align-items:flex-end;gap:8px;
  padding:10px 12px;border-top:1px solid var(--frost-border);
  background:rgba(255,255,255,.02);flex-shrink:0;
}
#chat-input{
  flex:1;background:var(--frost-surface);
  border:1px solid var(--frost-border);color:var(--text);
  border-radius:10px;padding:8px 12px;font-size:12px;
  resize:none;outline:none;min-height:36px;max-height:120px;
  font-family:inherit;line-height:1.5;
}
#chat-input:focus{border-color:rgba(167,139,250,.4)}
#chat-send{
  background:rgba(167,139,250,.22);border:1px solid rgba(167,139,250,.35);
  color:var(--accent);border-radius:10px;width:36px;height:36px;
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;font-size:16px;transition:all .2s;flex-shrink:0;
}
#chat-send:hover{background:rgba(167,139,250,.38)}

/* ── Reduced chat vertical icon ── */
#chat-panel.reduced{
  align-items:center;padding-top:0;
}
#reduce-icon{
  writing-mode:vertical-rl;font-size:11px;color:var(--accent);
  letter-spacing:.5px;padding:12px 0;cursor:pointer;
  display:none;
}
#chat-panel.reduced #reduce-icon{display:block}

/* ── Logs panel ── */
#logs-panel{
  height:0;overflow:hidden;border-top:1px solid var(--frost-border);
  transition:height .25s ease;flex-shrink:0;
  background:rgba(0,0,0,.35);
}
#logs-panel.open{height:180px}
#logs-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:5px 12px;border-bottom:1px solid var(--frost-border);
  background:rgba(255,255,255,.03);
}
#logs-header span{font-size:11px;color:var(--text-dim);font-weight:600;letter-spacing:.3px;text-transform:uppercase}
#logs-header button{background:none;border:none;color:var(--text-dim);cursor:pointer;font-size:13px;transition:color .2s}
#logs-header button:hover{color:var(--accent)}
#logs-content{
  height:calc(100% - 30px);overflow-y:auto;padding:8px 12px;
  font-family:'JetBrains Mono',monospace;font-size:11px;
  line-height:1.6;color:rgba(255,255,255,.65);
  white-space:pre-wrap;word-break:break-all;
  scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.1) transparent;
}

/* ── VCS panel ── */
#vcs-panel{
  height:0;overflow:hidden;border-top:1px solid var(--frost-border);
  transition:height .25s ease;flex-shrink:0;
  background:rgba(0,0,0,.35);
}
#vcs-panel.open{height:220px}
#vcs-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:5px 12px;border-bottom:1px solid var(--frost-border);
  background:rgba(255,255,255,.03);
}
#vcs-header span{font-size:11px;color:var(--text-dim);font-weight:600;letter-spacing:.3px;text-transform:uppercase}
#vcs-header button{background:none;border:none;color:var(--text-dim);cursor:pointer;font-size:13px;transition:color .2s}
#vcs-header button:hover{color:var(--accent)}
#vcs-body{
  height:calc(100% - 30px);overflow-y:auto;padding:8px 12px;
  font-family:'JetBrains Mono',monospace;font-size:11px;
  line-height:1.6;color:rgba(255,255,255,.65);
  white-space:pre-wrap;word-break:break-all;
  scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.1) transparent;
}
#vcs-actions{display:flex;gap:6px;padding:6px 12px;border-bottom:1px solid var(--frost-border);background:rgba(255,255,255,.02)}
#vcs-actions button{
  background:rgba(167,139,250,.15);border:1px solid rgba(167,139,250,.3);
  color:var(--accent);border-radius:6px;padding:3px 10px;font-size:11px;cursor:pointer;
}
#vcs-actions button:hover{background:rgba(167,139,250,.25)}
#vcs-actions button:disabled{opacity:.4;cursor:not-allowed}

/* ── Repo drop overlay ── */
#drop-overlay{
  position:fixed;inset:0;
  background:rgba(240,230,239,0.92);
  backdrop-filter:blur(8px);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:20px;z-index:200;
  transition:opacity .25s;
}
#drop-overlay.hidden{opacity:0;pointer-events:none}
#drop-zone{
  width:480px;max-width:90vw;
  border:2px dashed rgba(167,139,250,.4);
  border-radius:20px;
  padding:40px 32px;
  text-align:center;
  transition:all .2s;
  background:rgba(167,139,250,.05);
}
#drop-zone.drag-over{border-color:var(--accent);background:rgba(167,139,250,.12);transform:scale(1.02)}
#drop-zone .dz-icon{font-size:48px;margin-bottom:12px;opacity:.7}
#drop-zone .dz-title{font-size:18px;font-weight:700;color:var(--text);margin-bottom:6px}
#drop-zone .dz-sub{font-size:13px;color:var(--text-dim);margin-bottom:20px;line-height:1.5}
#repo-url-input{
  width:100%;background:var(--frost-surface);
  border:1px solid var(--frost-border);color:var(--text);
  border-radius:10px;padding:10px 14px;font-size:13px;outline:none;
  margin-bottom:10px;
}
#repo-url-input:focus{border-color:rgba(167,139,250,.5)}
#repo-url-input::placeholder{color:var(--text-dim)}
#clone-btn{
  width:100%;background:rgba(167,139,250,.22);
  border:1px solid rgba(167,139,250,.4);
  color:var(--accent);border-radius:10px;padding:10px;
  font-size:14px;font-weight:600;cursor:pointer;
  transition:all .2s;margin-bottom:10px;
}
#clone-btn:hover{background:rgba(167,139,250,.35)}
#clone-btn:disabled{opacity:.4;cursor:not-allowed}
.or-row{display:flex;align-items:center;gap:12px;margin:8px 0}
.or-line{flex:1;height:1px;background:var(--frost-border)}
.or-text{font-size:11px;color:var(--text-dim)}
#project-list-overlay{
  width:480px;max-width:90vw;
  display:flex;flex-direction:column;gap:6px;max-height:220px;overflow-y:auto;
  scrollbar-width:thin;
}
.proj-card{
  display:flex;align-items:center;gap:10px;
  padding:10px 14px;border-radius:12px;cursor:pointer;
  background:var(--frost-surface);border:1px solid var(--frost-border);
  transition:all .2s;
}
.proj-card:hover{background:rgba(167,139,250,.12);border-color:rgba(167,139,250,.3)}
.proj-card .pname{flex:1;font-size:13px;font-weight:600}
.proj-card .pstatus{font-size:10px;padding:2px 7px;border-radius:6px;font-weight:600}
.pstatus.running{background:rgba(74,222,128,.15);color:var(--green)}
.pstatus.stopped{background:rgba(255,255,255,.06);color:var(--text-dim)}
.pstatus.building{background:rgba(251,191,36,.12);color:var(--yellow)}
.proj-card .pport{font-size:10px;color:var(--text-dim)}
#skip-btn{
  background:none;border:1px solid var(--frost-border);
  color:var(--text-dim);border-radius:10px;padding:8px 20px;
  font-size:12px;cursor:pointer;transition:all .2s;
}
#skip-btn:hover{border-color:rgba(255,255,255,.25);color:var(--text)}
#clone-progress{font-size:12px;color:var(--text-dim);text-align:center;min-height:18px}

/* ── Toasts ── */
#toast-container{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:999;display:flex;flex-direction:column;gap:8px;align-items:center;pointer-events:none}
.toast{
  background:rgba(20,20,35,.92);border:1px solid var(--frost-border);
  color:var(--text);border-radius:10px;padding:9px 18px;
  font-size:12px;backdrop-filter:blur(12px);
  animation:toastIn .25s ease,toastOut .3s ease 2.7s forwards;
}
.toast.ok{border-color:rgba(74,222,128,.3);color:var(--green)}
.toast.err{border-color:rgba(248,113,113,.3);color:var(--red)}
@keyframes toastIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
@keyframes toastOut{to{opacity:0;transform:translateY(8px)}}

/* ── Project preview overlay ── */
.pw-tab{background:transparent;border:none;border-bottom:2px solid transparent;color:var(--text-dim);font-size:11px;font-weight:600;padding:6px 12px;cursor:pointer;border-radius:8px 8px 0 0;transition:all .15s}
.pw-tab:hover{color:var(--text)}
.pw-tab.active{color:var(--accent);border-bottom-color:var(--accent);background:rgba(167,139,250,.08)}
.pw-resize{position:absolute;z-index:5}
.pw-resize.n{top:-3px;left:8px;right:8px;height:6px;cursor:ns-resize}
.pw-resize.s{bottom:-3px;left:8px;right:8px;height:6px;cursor:ns-resize}
.pw-resize.e{right:-3px;top:8px;bottom:8px;width:6px;cursor:ew-resize}
.pw-resize.w{left:-3px;top:8px;bottom:8px;width:6px;cursor:ew-resize}
.pw-resize.ne{top:-4px;right:-4px;width:12px;height:12px;cursor:nesw-resize}
.pw-resize.nw{top:-4px;left:-4px;width:12px;height:12px;cursor:nwse-resize}
.pw-resize.se{bottom:-4px;right:-4px;width:12px;height:12px;cursor:nwse-resize}
.pw-resize.sw{bottom:-4px;left:-4px;width:12px;height:12px;cursor:nesw-resize}
.hud-mode-btn{background:var(--frost-surface);border:1px solid var(--frost-border);border-radius:10px;padding:3px 10px;font-size:10px;font-weight:600;color:var(--text-dim);cursor:pointer;transition:all .15s}
.hud-mode-btn:hover{color:var(--text)}
.hud-mode-btn.active{background:rgba(167,139,250,.2);border-color:rgba(167,139,250,.45);color:var(--accent)}
.hud-char{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;background:var(--frost-surface);border:1.5px solid var(--frost-border);cursor:pointer;transition:all .15s;position:relative}
.hud-char:hover{transform:scale(1.12)}
.hud-char.selected{border-color:rgba(167,139,250,.7);background:rgba(167,139,250,.18);transform:scale(1.12)}
.hud-char .hud-tip{position:absolute;bottom:calc(100% + 4px);left:50%;transform:translateX(-50%);font-size:8px;color:var(--text-dim);white-space:nowrap;background:var(--frost-surface);border:1px solid var(--frost-border);padding:2px 6px;border-radius:6px;opacity:0;transition:opacity .15s;pointer-events:none;z-index:6}
.hud-char:hover .hud-tip{opacity:1}
.hud-msg{display:flex;gap:8px;align-items:flex-start;animation:msgIn .25s ease-out}
.hud-msg .hud-avatar{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;background:var(--frost-surface);border:1.5px solid var(--frost-border)}
.hud-msg .hud-body{flex:1;min-width:0}
.hud-msg .hud-name{font-size:9px;font-weight:700;color:var(--text-dim);letter-spacing:.3px;text-transform:uppercase;margin-bottom:2px}
.hud-msg .hud-name .hud-alpha{color:var(--accent);font-weight:700}
.hud-msg .hud-text{background:var(--frost-surface);border:1px solid var(--frost-border);padding:8px 12px;border-radius:14px;border-top-left-radius:4px;font-size:12px;color:var(--text);line-height:1.5}
.hud-msg.user{flex-direction:row-reverse}
.hud-msg.user .hud-avatar{background:rgba(167,139,250,.15);border-color:rgba(167,139,250,.35)}
.hud-msg.user .hud-body{display:flex;flex-direction:column;align-items:flex-end}
.hud-msg.user .hud-text{background:rgba(167,139,250,.15);border-color:rgba(167,139,250,.3);border-top-left-radius:14px;border-top-right-radius:4px}
.hud-typing{display:flex;gap:8px;align-items:center;padding:4px 0;animation:msgIn .2s ease-out}
.hud-typing .hud-dots{display:flex;gap:4px;padding:8px 12px;background:var(--frost-surface);border:1px solid var(--frost-border);border-radius:12px}
.hud-typing .hud-dots span{width:6px;height:6px;border-radius:50%;background:rgba(139,122,158,.4);animation:thinkBounce 1.2s ease-in-out infinite}
.hud-typing .hud-dots span:nth-child(2){animation-delay:.2s}
.hud-typing .hud-dots span:nth-child(3){animation-delay:.4s}

/* ── Template wizard cards ── */
.template-card{
  display:flex;flex-direction:column;gap:6px;
  padding:12px 14px;border-radius:12px;cursor:pointer;
  background:var(--frost-surface);border:1px solid var(--frost-border);
  transition:all .2s;
}
.template-card:hover{background:rgba(167,139,250,.12);border-color:rgba(167,139,250,.3)}
.template-card.selected{background:rgba(167,139,250,.18);border-color:rgba(167,139,250,.5)}
.template-card .t-title{
  font-size:13px;font-weight:600;color:var(--text);display:flex;align-items:center;gap:6px
}
.template-card .t-desc{
  font-size:11px;color:var(--text-dim);line-height:1.4
}
.template-card .t-tag{
  font-size:10px;color:var(--accent);background:rgba(167,139,250,.1);border:1px solid rgba(167,139,250,.2);border-radius:4px;padding:1px 6px;align-self:flex-start
}

/* ── Mobile section switcher (files / code / chat) ── */
#mobile-sections{display:none}

/* ── Mobile responsive ── */
@media(max-width:768px){
  :root{--chat-w:100vw}
  #main{flex-direction:column}
  #mobile-sections{display:flex;flex-shrink:0;align-items:stretch;background:rgba(240,230,239,.92);border-bottom:1px solid var(--frost-border);z-index:501;position:relative}
  #mobile-sections button{flex:1;background:none;border:none;color:var(--text-dim);font-size:12px;font-weight:600;padding:12px 4px;cursor:pointer;border-bottom:2px solid transparent;-webkit-tap-highlight-color:transparent;font-family:inherit}
  #mobile-sections button.active{color:var(--accent);border-bottom-color:var(--accent);background:rgba(167,139,250,.08)}
  body[data-msection="files"] #sidebar{display:flex}
  body[data-msection="files"] #editor-wrap,
  body[data-msection="files"] #chat-panel{display:none!important}
  body[data-msection="code"] #editor-wrap{display:flex}
  body[data-msection="code"] #sidebar,
  body[data-msection="code"] #chat-panel{display:none!important}
  body[data-msection="chat"] #chat-panel{display:flex}
  body[data-msection="chat"] #sidebar,
  body[data-msection="chat"] #editor-wrap{display:none!important}
  #sidebar{width:100%;border-right:none;flex:1;min-height:0}
  #editor-wrap{flex:1;min-height:0}
  #chat-panel{width:100%!important;position:fixed!important;top:calc(100px + env(safe-area-inset-top,0))!important;right:0;bottom:0;left:0;border-left:none!important;z-index:500 !important}
  #chat-panel{padding-top:env(safe-area-inset-top,0);padding-bottom:env(safe-area-inset-bottom,0);padding-left:env(safe-area-inset-left,0);padding-right:env(safe-area-inset-right,0);box-sizing:border-box}
  #chat-header{padding-left:calc(12px + env(safe-area-inset-left,0));padding-right:calc(12px + env(safe-area-inset-right,0));padding-top:calc(10px + env(safe-area-inset-top,0))}
  #chat-input-row{padding:12px 14px calc(12px + env(safe-area-inset-bottom,0))!important;gap:8px}
  #chat-input{min-height:44px;font-size:16px;padding:10px 14px}
  #chat-fs-input{font-size:16px}
  #code-editor{font-size:16px;-webkit-text-size-adjust:100%}
  #editor-toolbar{flex-wrap:wrap;gap:6px}
  #editor-toolbar .einfo{width:100%;flex-basis:100%}
  #chat-send,#chat-mic{width:44px;height:44px;font-size:16px}
  #sections-bar{padding:8px 12px;border-bottom:1px solid var(--frost-border)}
  .section-btn{padding:8px 14px;font-size:12px}
  #project-window{min-width:90vw;min-height:60vh;left:5vw!important;top:calc(10vh + env(safe-area-inset-top,0))!important}
  #notif-dropdown{width:min(320px,90vw)!important;right:5vw!important}
  #topbar{padding:calc(8px + env(safe-area-inset-top,0)) 10px;gap:8px}
  #topbar .logo{font-size:13px}
  #project-select{max-width:160px;font-size:11px}
  .topbtn{padding:5px 8px;font-size:11px}
  .topbtn{min-height:40px;min-width:40px}
}
@media(max-width:480px){
  #chat-panel{font-size:11px}
  #chat-input-row{padding:12px 14px calc(12px + env(safe-area-inset-bottom,0))!important;gap:6px}
  #chat-input{padding:10px 12px;font-size:12px;min-height:40px}
  #chat-send,#chat-mic{width:40px;height:40px;font-size:13px}
  .cmsg{padding:7px 10px;font-size:11px}
  #drop-zone{width:95vw;padding:24px 16px}
  #drop-zone .dz-icon{font-size:36px}
  #drop-zone .dz-title{font-size:16px}
  #repo-url-input,#repo-name-input{font-size:12px;padding:8px 10px}
  #clone-btn{padding:8px 14px;font-size:12px}
   #notif-dropdown{width:calc(100vw - 20px)!important;right:10px!important;max-width:none!important}
  #dashboard-window{width:96vw;left:2vw;top:calc(6vh + env(safe-area-inset-top,0));height:88vh}
  #dw-body{padding:12px 12px calc(12px + env(safe-area-inset-bottom,0));font-size:12px}
  #dw-body .dw-section{margin-bottom:12px}
  #dw-body .dw-section h3{font-size:10px}
  #dw-body .dw-stat{font-size:11px}
  #dw-files .dw-file{font-size:9px}
  #dw-files{max-height:14vh}
  #dw-skills{max-height:26vh}
  #dw-skills .dw-skill-card{padding:7px 9px}
  #dw-skills .dw-skill-name{font-size:11px}
  #dw-skills .dw-skill-desc{font-size:9px}
}
@media(max-width:850px) and (orientation:landscape){
  #dashboard-window{left:4vw;top:6vh;width:92vw;height:88vh}
}

/* ── Dashboard pop-out ── */
#dashboard-window{
  position:fixed;left:5vw;top:10vh;width:50vw;height:60vh;
  z-index:600;border-radius:16px;overflow:hidden;display:none;
}
#dw-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:8px 12px;border-bottom:1px solid var(--frost-border);
  background:rgba(255,255,255,.04);font-size:13px;font-weight:600;
  color:var(--accent);white-space:nowrap;overflow:hidden;
}
#dw-body{
  padding:16px;overflow-y:auto;height:calc(100% - 36px);
  font-family:'Segoe UI',system-ui,sans-serif;font-size:13px;
  color:var(--text);line-height:1.6;
}
#dw-body .dw-section{margin-bottom:18px}
#dw-body .dw-section h3{
  font-size:11px;text-transform:uppercase;letter-spacing:.5px;
  color:var(--text-dim);margin-bottom:8px
}
#dw-body .dw-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px 12px}
#dw-body .dw-stat{background:var(--frost-surface);border:1px solid var(--frost-border);
  border-radius:8px;padding:8px 10px;font-size:12px}
#dw-body .dw-stat .dw-label{color:var(--text-dim);font-size:10px}
#dw-body .dw-stat .dw-value{color:var(--text);font-weight:600;font-size:13px}
#dw-body pre{background:rgba(0,0,0,.25);border-radius:8px;padding:10px;
  font-size:11px;line-height:1.5;overflow:auto;max-height:140px;
  border:1px solid var(--frost-border);font-family:'JetBrains Mono',monospace}
#dw-files{max-height:120px;overflow-y:auto;font-family:'JetBrains Mono',monospace;font-size:10px;line-height:1.4}
  #dw-files .dw-file{padding:2px 0;color:var(--text-dim)}
  #dw-files .dw-file:before{content:'• ';color:var(--accent2)}
  .dw-tag{display:inline-block;font-size:9px;padding:1px 5px;border-radius:3px;
    background:rgba(167,139,250,.1);color:var(--accent);margin-right:3px}
  .dw-hint{font-size:9px;font-weight:400;color:var(--text-dim);text-transform:none;letter-spacing:0;margin-left:6px}
  #dw-skills{max-height:200px;overflow-y:auto;display:flex;flex-direction:column;gap:8px}
  #dw-skills .dw-skill-card{background:var(--frost-surface);border:1px solid var(--frost-border);
    border-radius:10px;padding:8px 10px}
  #dw-skills .dw-skill-card:hover{border-color:rgba(167,139,250,.4)}
  #dw-skills .dw-skill-top{display:flex;justify-content:space-between;align-items:center;gap:8px}
  #dw-skills .dw-skill-name{font-size:12px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #dw-skills .dw-skill-stars{font-size:10px;color:var(--yellow);white-space:nowrap}
  #dw-skills .dw-skill-desc{font-size:10px;color:var(--text-dim);margin-top:3px;line-height:1.4;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  #dw-skills .dw-skill-meta{margin-top:5px;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
  #dw-skills .dw-skill-lang{font-size:9px;color:var(--accent2);font-weight:600}
  #dw-skills .dw-skill-apply{font-size:10px;padding:3px 10px;border-radius:6px;cursor:pointer;white-space:nowrap;
    background:rgba(74,222,128,.15);border:1px solid rgba(74,222,128,.4);color:var(--green)}
  #dw-skills .dw-skill-apply:hover{background:rgba(74,222,128,.28)}
  #dw-skills .dw-skill-apply[disabled]{opacity:.5;cursor:default}

/* ── Inline Vibe chat dashboard (pinned above chat messages) ── */
#chat-dashboard{
  display:none;margin:8px 10px 0;padding:10px 12px;flex-shrink:0;
  background:var(--frost-surface);border:1px solid rgba(167,139,250,.35);
  border-radius:12px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.25);
}
#chat-dashboard.open{display:block;animation:cdIn .3s ease}
@keyframes cdIn{from{transform:translateY(-10px);opacity:0}to{transform:translateY(0);opacity:1}}
#chat-panel.reduced #chat-dashboard{display:none!important}
#chat-dashboard .cd-top{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
#chat-dashboard .cd-title{font-size:11px;font-weight:700;color:var(--accent);white-space:nowrap}
#chat-dashboard .cd-project{font-size:11px;font-weight:600;color:var(--text);max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#chat-dashboard .cd-status{font-size:9px;padding:1px 6px;border-radius:6px;font-weight:600;text-transform:uppercase;letter-spacing:.5px}
#chat-dashboard .cd-status.running{background:rgba(74,222,128,.15);color:var(--green)}
#chat-dashboard .cd-status.stopped{background:rgba(248,113,113,.15);color:var(--red)}
#chat-dashboard .cd-port{font-size:10px;color:var(--text-dim);white-space:nowrap}
#chat-dashboard .cd-btn{background:rgba(167,139,250,.12);border:1px solid rgba(167,139,250,.3);color:var(--accent);
  border-radius:6px;padding:2px 7px;font-size:10px;cursor:pointer;line-height:1.4;flex-shrink:0}
#chat-dashboard .cd-btn:hover{background:rgba(167,139,250,.25)}
#chat-dashboard .cd-btn.danger{color:var(--red);border-color:rgba(248,113,113,.4);background:rgba(248,113,113,.1)}
#chat-dashboard .cd-stats{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
#chat-dashboard .cd-stat{font-size:10px;color:var(--text-dim);background:rgba(0,0,0,.18);border-radius:6px;padding:3px 8px}
#chat-dashboard .cd-stat b{color:var(--text);font-weight:600}
#chat-dashboard .cd-note{font-size:10px;color:var(--text-dim);margin-top:6px;font-style:italic}

</style>
</head>
<body>

<!-- ── Repo drop / project picker overlay ── -->
<div id="drop-overlay" class="hidden">
  <div id="drop-zone">
    <div class="dz-icon">🧬</div>
    <div class="dz-title">VibeCode</div>
    <div class="dz-sub">Drop in a Git repo URL to start a containerised project.<br>Files are live-editable. Lilly runs the IDE chat.</div>
    <input id="repo-url-input" type="text" placeholder="https://github.com/user/repo.git" autocomplete="off">
    <input id="repo-name-input" type="text" placeholder="project-name (optional)" autocomplete="off" style="width:100%;background:var(--frost-surface);border:1px solid var(--frost-border);color:var(--text);border-radius:10px;padding:10px 14px;font-size:13px;outline:none;margin-bottom:10px">
    <button id="clone-btn" onclick="cloneRepo()">⬇ Clone &amp; Open</button>
    <div id="clone-progress"></div>
    <div class="or-row"><div class="or-line"></div><div class="or-text">or open existing</div><div class="or-line"></div></div>
    <button id="create-template-btn" onclick="showTemplateWizard()" style="width:100%;background:rgba(167,139,250,.15);border:1px solid rgba(167,139,250,.4);color:var(--accent);border-radius:10px;padding:10px;font-size:13px;font-weight:600;cursor:pointer;transition:all .2s;margin-bottom:10px">🏗 Create from template</button>
  </div>

  <!-- Template wizard -->
  <div id="template-wizard" style="display:none;width:480px;max-width:90vw;background:var(--frost-bg);border:1px solid var(--frost-border);border-radius:16px;box-shadow:0 12px 48px rgba(0,0,0,.6);backdrop-filter:blur(24px) saturate(1.4);overflow:hidden">
    <div style="padding:14px 18px;border-bottom:1px solid var(--frost-border);display:flex;justify-content:space-between;align-items:center">
      <span style="font-size:14px;font-weight:600;color:var(--accent)">🏗 Create Project</span>
      <button onclick="closeTemplateWizard()" class="topbtn" style="font-size:13px">✕</button>
    </div>
    <div id="template-list" style="padding:12px 14px;max-height:320px;overflow-y:auto;display:flex;flex-direction:column;gap:8px"></div>
    <div style="padding:10px 14px;border-top:1px solid var(--frost-border);display:flex;gap:8px">
      <input id="template-project-name" type="text" placeholder="project-name (optional)" autocomplete="off" style="flex:1;background:var(--frost-surface);border:1px solid var(--frost-border);color:var(--text);border-radius:10px;padding:8px 12px;font-size:13px;outline:none">
      <button onclick="createFromSelectedTemplate()" id="template-create-btn" style="padding:8px 16px;background:rgba(167,139,250,.22);border:1px solid rgba(167,139,250,.4);color:var(--accent);border-radius:10px;font-size:13px;font-weight:600;cursor:pointer">Create</button>
    </div>
  </div>

  <div id="project-list-overlay"></div>
  <button id="skip-btn" onclick="closeDropOverlay()">✕ Close</button>
</div>

<!-- ── Top bar ── -->
<div id="topbar">
  <div class="logo">Vibe<span>Code</span></div>
  <select id="project-select" onchange="switchProject(this.value)">
    <option value="">— select project —</option>
  </select>
  <div id="status-dot"></div>
  <span id="status-label">no project</span>
  <a id="project-url" href="#" target="_blank" style="display:none"></a>
  <button class="topbtn" onclick="openDropOverlay()" title="Clone / open project">+ Project</button>
  <button class="topbtn" id="build-btn" onclick="buildProject()" style="display:none">🔨 Build</button>
  <button class="topbtn success" id="run-btn" onclick="runProject()" style="display:none">▶ Run</button>
  <button class="topbtn danger" id="stop-btn" onclick="stopProject()" style="display:none">■ Stop</button>
    <button class="topbtn" id="logs-toggle-btn" onclick="toggleLogs()" style="display:none">📋 Logs</button>
    <button class="topbtn" id="vcs-toggle-btn" onclick="toggleVCS()" style="display:none">🔀 VCS</button>
   <button class="topbtn" id="download-btn" onclick="downloadProject()" title="Download project as .zip" style="display:none">⬇</button>
   <button class="topbtn" id="notify-btn" onclick="showNotifyPanel()" title="Send push notification" style="display:none">🔔</button>
   <button class="topbtn" onclick="toggleSidebar()" title="Toggle file tree">📁</button>
  <button class="topbtn" onclick="toggleChat()" title="Toggle chat">💬</button>
  <button class="topbtn" onclick="testDashboard()" title="Test project dashboard">📊 Test Dashboard</button>
</div>

<!-- ── Main layout ── -->
<div id="main">

  <!-- Mobile section switcher (files / code / chat) -->
  <div id="mobile-sections">
    <button data-sec="files" onclick="setMobileSection('files')">📁 Files</button>
    <button data-sec="code" onclick="setMobileSection('code')">✏️ Code</button>
    <button data-sec="chat" onclick="setMobileSection('chat')">💬 Chat</button>
  </div>

  <!-- File manager sidebar -->
  <div id="sidebar" class="frost" style="border-radius:0">
    <div id="sidebar-header">
      <span id="sidebar-title">Files</span>
      <button onclick="navigateUp()" id="nav-up-btn" title="Go up" style="display:none">↑</button>
    </div>
    <div id="file-tree"></div>
  </div>

  <!-- Editor + logs -->
  <div id="editor-wrap">
    <div id="editor-tabs"></div>
    <div id="editor-toolbar">
      <span class="einfo" id="editor-info">No file open</span>
      <button class="save-btn" id="save-btn" onclick="saveCurrentFile()" style="display:none">💾 Save</button>
      <button onclick="applyAISuggestion()" id="apply-ai-btn" style="display:none">✨ Apply AI</button>
      <button onclick="askAboutFile()" id="ask-btn" style="display:none">🤖 Ask Lilly</button>
    </div>
    <div id="editor-box">
      <div id="editor-placeholder">
        <div class="ph-icon">🗂</div>
        <div class="ph-text">Select a file from the tree to start editing.<br>Changes are saved live to the project.</div>
      </div>
      <textarea id="code-editor" spellcheck="false" style="display:none" oninput="onEditorChange()" onkeydown="handleEditorKey(event)"></textarea>
    </div>
    <div id="logs-panel">
      <div id="logs-header">
        <span>Container Logs</span>
        <div style="display:flex;gap:8px">
          <button onclick="refreshLogs()" title="Refresh">↻</button>
          <button onclick="toggleLogs()" title="Close">✕</button>
        </div>
      </div>
      <div id="logs-content">No logs yet.</div>
    </div>
    <div id="vcs-panel">
      <div id="vcs-header">
        <span>Git — <span id="vcs-branch-label">—</span></span>
        <div style="display:flex;gap:8px">
          <button onclick="refreshVCS()" title="Refresh">↻</button>
          <button onclick="toggleVCS()" title="Close">✕</button>
        </div>
      </div>
      <div id="vcs-actions">
        <button onclick="gitCommit()" title="Stage all and commit">Commit</button>
        <button onclick="gitPush()" title="Push to remote">Push</button>
        <button onclick="gitDiff()" title="Show diff">Diff</button>
      </div>
      <div id="vcs-body">No VCS info yet. Open a git project and click refresh.</div>
    </div>
  </div>

  <!-- Chat panel (frost window) -->
  <div id="chat-panel" class="frost" style="border-radius:0">
    <div id="chat-header">
      <span class="title">🐶 Lilly · VibeCode</span>
      <div class="chat-controls">
        <button class="chat-ctrl-btn non-reduce" onclick="chatFullscreen()" title="Fullscreen chat">⛶</button>
        <button class="chat-ctrl-btn non-reduce" onclick="reduceChat()" title="Reduce chat">→</button>
        <button class="chat-ctrl-btn" onclick="hideChat()" title="Hide chat">✕</button>
      </div>
    </div>
    <div id="reduce-icon" onclick="expandChat()" title="Expand chat">Lilly Chat</div>
    <div id="chat-context-bar">
      <input type="checkbox" id="ctx-include-file" checked title="Include current file as context">
      <span>context:</span>
      <span class="ctx-file" id="ctx-file-label">no file</span>
    </div>
    <!-- Inline Vibe chat dashboard — pinned above the messages -->
    <div id="chat-dashboard">
      <div class="cd-top">
        <span class="cd-title">📊 Vibe Dashboard</span>
        <span class="cd-project" id="cd-project">no project</span>
        <span class="cd-status" id="cd-status">stopped</span>
        <span class="cd-port" id="cd-port"></span>
        <div style="flex:1"></div>
        <button class="cd-btn" onclick="refreshChatDashboard()" title="Refresh">↻</button>
        <button class="cd-btn danger" onclick="closeChatDashboard()" title="Hide dashboard">✕</button>
      </div>
