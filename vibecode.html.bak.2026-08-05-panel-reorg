  const box = document.getElementById('pw-huddle-messages');
  const old = document.getElementById('hud-typing');
  if (old) old.remove();
  if (!active) return;
  const el = document.createElement('div');
  el.className = 'hud-typing';
  el.id = 'hud-typing';
  el.innerHTML = '<div class="hud-avatar">👥</div><div class="hud-dots"><span></span><span></span><span></span></div>';
