<script>
// ── Editor / tabs ─────────────────────────────────────────────────
 async function openFile(path) {
   // Already open?
   const existing = openTabs.findIndex(t => t.path === path);
   if (existing !== -1) { activateTab(existing); if (isMobile()) setMobileSection('code'); return; }
   try {
     const r = await fetch('/api/vibecode/file/'+currentProject+'?path='+encodeURIComponent(path));
     const d = await r.json();
     if (d.error) { toast(d.error,'err'); return; }
     openTabs.push({ path: d.path, lang: d.lang, content: d.content, dirty: false });
     activeTab = openTabs.length - 1;
     renderTabs();
     activateTab(activeTab);
     updateCtxBar();
     if (isMobile()) setMobileSection('code');
   } catch(e) { toast('Could not open file','err'); }
 }

function activateTab(idx) {
  activeTab = idx;
  const tab = openTabs[idx];
  if (!tab) return;
  currentFile = tab.path;
  const editor = document.getElementById('code-editor');
  const placeholder = document.getElementById('editor-placeholder');
  placeholder.style.display = 'none';
  editor.style.display = 'block';
  editor.value = tab.content;
  document.getElementById('editor-info').textContent = tab.path + ' · ' + tab.lang;
  document.getElementById('save-btn').style.display = '';
  document.getElementById('ask-btn').style.display = '';
  // highlight active tab
  document.querySelectorAll('.etab').forEach((t,i) => t.classList.toggle('active', i===idx));
  // update file tree highlight
  document.querySelectorAll('.ftree-item').forEach(el => {
    const name = el.querySelector('.name')?.textContent;
    const relPath = cwd ? cwd+'/'+name : name;
    el.classList.toggle('active', relPath === currentFile || name === currentFile.split('/').pop() && el.dataset && !cwd);
  });
  updateCtxBar();
  // mark save button
  document.getElementById('save-btn').classList.toggle('dirty', tab.dirty);
}

function renderTabs() {
  const bar = document.getElementById('editor-tabs');
  bar.innerHTML = '';
  openTabs.forEach((t, i) => {
    const tab = document.createElement('div');
    tab.className = 'etab' + (i===activeTab?' active':'');
    const fname = t.path.split('/').pop();
    tab.innerHTML = `<span>${fileIcon(fname)} ${fname}</span>${t.dirty?'<span class="dirty">●</span>':''}<span class="close" onclick="closeTab(event,${i})">✕</span>`;
    tab.onclick = (e) => { if (!e.target.classList.contains('close')) activateTab(i); };
    bar.appendChild(tab);
  });
}

function closeTab(e, idx) {
  e.stopPropagation();
  if (openTabs[idx]?.dirty && !confirm('Unsaved changes in '+openTabs[idx].path+'. Close anyway?')) return;
  openTabs.splice(idx, 1);
  if (activeTab >= openTabs.length) activeTab = openTabs.length - 1;
  renderTabs();
  if (activeTab >= 0) activateTab(activeTab);
  else showPlaceholder();
}

function showPlaceholder() {
  document.getElementById('editor-placeholder').style.display='flex';
  document.getElementById('code-editor').style.display='none';
  document.getElementById('editor-info').textContent = 'No file open';
  document.getElementById('save-btn').style.display='none';
  document.getElementById('ask-btn').style.display='none';
  currentFile = null;
}

function onEditorChange() {
  if (activeTab < 0) return;
  openTabs[activeTab].content = document.getElementById('code-editor').value;
  openTabs[activeTab].dirty = true;
  renderTabs();
  document.getElementById('save-btn').classList.add('dirty');
  // Live code change on the fly — debounced auto-save so the running
  // container picks up edits without hitting Ctrl+S.
  if (_autosaveTimer) clearTimeout(_autosaveTimer);
  _autosaveTimer = setTimeout(autoSaveCurrentFile, 1200);
}

// Silent background save (no toast) used by the live auto-save debounce.
async function autoSaveCurrentFile() {
  _autosaveTimer = null;
  if (activeTab < 0 || !currentProject) return;
  const tab = openTabs[activeTab];
  if (!tab || !tab.dirty) return;
  try {
    const r = await fetch('/api/vibecode/file/' + currentProject + '?path=' + encodeURIComponent(tab.path), {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({content: tab.content})
    });
    const d = await r.json();
    if (r.ok) {
      tab.dirty = false;
      _autosaveCount++;
      renderTabs();
      document.getElementById('save-btn').classList.remove('dirty');
    } else {
      console.error('autosave failed:', d.error);
    }
  } catch (e) {
    console.error('autosave network error', e);
  }
}

function handleEditorKey(e) {
  // Tab → insert 2 spaces
  if (e.key==='Tab') {
    e.preventDefault();
    const el = e.target;
    const s = el.selectionStart, end = el.selectionEnd;
    el.value = el.value.substring(0,s)+'  '+el.value.substring(end);
    el.selectionStart = el.selectionEnd = s+2;
    onEditorChange();
  }
  // Ctrl+S → save
  if ((e.ctrlKey||e.metaKey) && e.key==='s') {
    e.preventDefault();
    saveCurrentFile();
  }
}

async function saveCurrentFile() {
  if (activeTab < 0 || !currentProject) return;
  const tab = openTabs[activeTab];
  try {
    const r = await fetch('/api/vibecode/file/'+currentProject+'?path='+encodeURIComponent(tab.path), {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({content: tab.content})
    });
    const d = await r.json();
    if (!r.ok) { toast(d.error||'Save failed','err'); return; }
    tab.dirty = false;
    renderTabs();
    document.getElementById('save-btn').classList.remove('dirty');
    toast('Saved '+tab.path,'ok');
  } catch(e) { toast('Save error','err'); }
}

function toggleSidebar() {
  if (isMobile()) { setMobileSection('files'); return; }
  document.getElementById('sidebar').classList.toggle('collapsed');
}

function updateCtxBar() {
  const label = document.getElementById('ctx-file-label');
  label.textContent = currentFile || 'no file';
}
