function populateDashboard(d) {
  document.getElementById('dw-project').textContent = d.project || '—';
  const statusEl = document.getElementById('dw-status');
  statusEl.textContent = d.status || 'stopped';
  statusEl.className = 'dw-value';

  document.getElementById('dw-port').textContent = d.port || '—';
  document.getElementById('dw-files-count').textContent = d.file_count || '0';

  const backend = d.backend || '?';
  const ready = d.llm_ready;
  document.getElementById('dw-backend').textContent = backend;
  document.getElementById('dw-backend').style.color = ready ? 'var(--green)' : 'var(--red)';

  const models = d.llm_models || [];
  document.getElementById('dw-models').textContent = models.length
    ? models.slice(0,3).join(', ')
    : (ready ? 'loading…' : 'unavailable');

  document.getElementById('dw-location').textContent = d.location || '—';

  const w = d.weather?.current || {};
  document.getElementById('dw-weather').textContent = w.temp_c
    ? `${w.temp_c}°C — ${w.desc}`
    : '—';

  // Language breakdown
  const langs = d.lang_breakdown || {};
  const langEl = document.getElementById('dw-langs');
  if (Object.keys(langs).length) {
    langEl.innerHTML = Object.entries(langs)
      .map(([ext, cnt]) => `<span class="dw-tag">${ext} (${cnt})</span>`)
      .join('');
  } else {
    langEl.textContent = 'No files';
  }

  // File list
  const files = d.files || [];
  const filesEl = document.getElementById('dw-files');
  if (files.length) {
    filesEl.innerHTML = files.slice(0, 50)
      .map(f => `<div class="dw-file">${f}</div>`)
      .join('');
    if (files.length > 50) {
      filesEl.innerHTML += `<div class="dw-file">… and ${files.length - 50} more</div>`;
    }
  } else {
    filesEl.textContent = 'No files';
  }

  // Skills
  const skills = d.skills || [];
  const skillsEl = document.getElementById('dw-skills');
  if (skills.length) {
    skillsEl.innerHTML = skills.map(s => {
      const stars = s.stars ? `<span class="dw-skill-stars">⭐ ${s.stars}</span>` : '';
      const desc = s.description ? `<div class="dw-skill-desc">${escHtml(s.description)}</div>` : '';
      const lang = s.language ? `<span class="dw-skill-lang">${escHtml(s.language)}</span>` : '';
      const tags = (s.tags || []).slice(0,4).map(t => `<span class="dw-tag">${escHtml(t)}</span>`).join('');
      const times = s.used_count ? `<span class="dw-skill-stars" style="color:var(--text-dim)">· used ${s.used_count}×</span>` : '';
      return `<div class="dw-skill-card">
        <div class="dw-skill-top">
          <span class="dw-skill-name" title="${escHtml(s.repo_url||'')}">${escHtml(s.name)}</span>
          <div style="display:flex;align-items:center;gap:6px">${stars}${times}
            <button class="dw-skill-apply" onclick="applySkill('${escHtml(s.key)}', this)">⚡ Apply</button>
          </div>
        </div>${desc}
        <div class="dw-skill-meta">${lang}${tags}</div>
      </div>`;
    }).join('');
  } else {
    skillsEl.innerHTML = '<div style="font-size:11px;color:var(--text-dim)">No skills yet — drop a GitHub link in chat or ask Lilly to "create something" and a suggested repo becomes a skill.</div>';
  }

  // Update preview text
  const previewText = document.getElementById('dw-preview-text');
  if (d.status === 'running' && d.port) {
    previewText.textContent = `Project is running. Use the preview button to open it.`;
  } else if (d.port) {
    previewText.textContent = `Project built but not running. Click Run to start, or use the static preview.`;
  } else {
    previewText.textContent = 'No port allocated. Use the preview button to view files directly.';
  }
}

