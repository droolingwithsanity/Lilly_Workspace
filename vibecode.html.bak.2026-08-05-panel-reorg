function startStatusPoll() {
  if (statusPollTimer) clearInterval(statusPollTimer);
  if (!currentProject) return;
  pollStatus();
  statusPollTimer = setInterval(pollStatus, 6000);
}

async function pollStatus() {
  if (!currentProject) return;
  try {
    const r = await fetch('/api/vibecode/status/'+currentProject);
    const d = await r.json();
    const s = d.status || 'stopped';
    setStatus(s === 'running' ? 'running' : s === 'exited' ? 'error' : 'stopped', s);
    const pw = document.getElementById('project-window');
    if (pw && pw.style.display !== 'none') updatePwLiveBadge(s === 'running');
    const urlEl = document.getElementById('project-url');
    if (s === 'running' && d.url) {
      urlEl.href = d.url; urlEl.textContent = d.url; urlEl.style.display='';
    } else {
      const staticUrl = '/vibecode/p/' + currentProject;
      urlEl.href = staticUrl; urlEl.textContent = staticUrl; urlEl.style.display='';
