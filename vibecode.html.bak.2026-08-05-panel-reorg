async function refreshVCS() {
  if (!currentProject) return;
  const body = document.getElementById('vcs-body');
  body.textContent = 'Loading…';
  try {
    const [statusR, logR, branchesR] = await Promise.all([
      fetch('/api/vibecode/git/status/'+currentProject),
      fetch('/api/vibecode/git/log/'+currentProject),
      fetch('/api/vibecode/git/branches/'+currentProject),
    ]);
    const status = await statusR.json();
    const log = await logR.json();
    const branches = await branchesR.json();

    document.getElementById('vcs-branch-label').textContent = status.branch || '—';
    let text = '';
    text += 'branch: ' + (status.branch || '—') + '\n';
    text += 'status: ' + (status.status || '—') + '\n\n';
    if (log.commits && log.commits.length) {
      text += 'commits:\n';
      log.commits.forEach(c => {
        text += '  ' + (c.hash||'') + ' ' + (c.date||'') + ' ' + (c.message||'') + '\n';
      });
    } else {
      text += 'No commits yet.\n';
    }
    if (branches.local && branches.local.length) {
      text += '\nbranches:\n';
      branches.local.forEach(b => {
        text += '  * ' + b + '\n';
      });
    }
    body.textContent = text;
  } catch(e) {
    body.textContent = 'Error loading VCS info';
  }
}
