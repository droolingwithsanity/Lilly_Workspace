async function sendHuddleMessage() {
  const input = document.getElementById('pw-huddle-input');
  const msg = input.value.trim();
  if (!msg) return;
  input.value = '';
  appendHuddleMsg(msg, 'You', '', true, false);

  let ctx = 'Agentic huddle for the VibeCode project.\n';
  if (currentProject) {
    ctx += 'Project: ' + currentProject + '\n';
    try {
      const d = await (await fetch('/api/vibecode/dashboard/' + encodeURIComponent(currentProject))).json();
      ctx += 'Status: ' + (d.status || 'stopped') + ' · Files: ' + (d.file_count ?? 0) + ' · Port: ' + (d.port || '—') + '\n';
      if (d.stack && d.stack.length) ctx += 'Stack: ' + d.stack.join(', ') + '\n';
      if (d.skills && d.skills.length) ctx += 'Reusable skills: ' + d.skills.map(s => s.name || s.key).join(', ') + '\n';
    } catch(e) {}
  }
  if (activeTab >= 0 && openTabs[activeTab]) {
    const f = openTabs[activeTab];
    ctx += 'Current file: ' + f.name + '\n```\n' + (f.content || '').slice(0, 3000) + '\n```\n';
  }
  ctx += '\nAs the team, discuss and respond to: ' + msg;

  huddleTyping(true);
  const body = { message: ctx, selected: 'puppy', mode: pwHuddleMode, characters: pwHuddleChars, muted: true };
  try {
    const r = await fetch('/api/group_chat', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    huddleTyping(false);
    const d = await r.json();
    if (!r.ok) { appendHuddleMsg(d.error || 'Group chat failed', 'System', '', false, false); return; }
    (d.responses || []).forEach(resp => {
      appendHuddleMsg(resp.text, resp.name, resp.emoji, false, !!resp.alpha);
    });
    if (!(d.responses || []).length) appendHuddleMsg('The team is quiet right now.', 'System', '', false, false);
  } catch(e) {
    huddleTyping(false);
    appendHuddleMsg('Huddle error: ' + (e.message || e), 'System', '', false, false);
  }
}

