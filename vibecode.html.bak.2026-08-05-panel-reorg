  const ws = new WebSocket(proto + '://' + location.host + '/api/vibecode/logs/ws/' + slug);
  streamEl._ws = ws;
  ws.onopen = () => { streamEl.textContent = ''; };
  ws.onmessage = (e) => {
    streamEl.textContent += e.data + '\n';
    streamEl.scrollTop = streamEl.scrollHeight;
  };
  ws.onclose = () => { if (streamEl._ws === ws) loadingEl.style.display = 'none'; };
  ws.onerror = () => { setTimeout(() => { if (streamEl._ws === ws) loadingEl.style.display = 'none'; }, 800); };
}

// ── Draggable + corner-resizable overlay ─────────────────────────────
function makeProjectWindowDraggable() {
  const win = document.getElementById('project-window');
  const header = document.getElementById('pw-header');
  let sx, sy, ox, oy;
  header.addEventListener('pointerdown', (e) => {
    if (win.dataset.maximized === 'true' || e.target.closest('button,a')) return;
    sx = e.clientX; sy = e.clientY;
    ox = win.offsetLeft; oy = win.offsetTop;
    header.setPointerCapture(e.pointerId);
    header.style.cursor = 'grabbing';
    const move = (ev) => {
      const dx = ev.clientX - sx, dy = ev.clientY - sy;
      win.style.left = Math.min(Math.max(0, ox + dx), window.innerWidth - 120) + 'px';
      win.style.top = Math.min(Math.max(0, oy + dy), window.innerHeight - 48) + 'px';
    };
    const up = (ev) => {
      header.removeEventListener('pointermove', move);
      header.removeEventListener('pointerup', up);
      header.style.cursor = 'grab';
    };
    header.addEventListener('pointermove', move);
    header.addEventListener('pointerup', up);
  });
}

function pwInitResize() {
  const win = document.getElementById('project-window');
  const minW = 320, minH = 220;
  document.querySelectorAll('.pw-resize').forEach(h => {
    h.addEventListener('pointerdown', (e) => {
      if (win.dataset.maximized === 'true') return;
      e.preventDefault(); e.stopPropagation();
      const dir = h.dataset.dir;
      const sx = e.clientX, sy = e.clientY;
      const r = win.getBoundingClientRect();
      h.setPointerCapture(e.pointerId);
      const move = (ev) => {
        const dx = ev.clientX - sx, dy = ev.clientY - sy;
        let { left, top, width, height } = r;
        if (dir.includes('e')) width = r.width + dx;
        if (dir.includes('s')) height = r.height + dy;
        if (dir.includes('w')) { width = r.width - dx; left = r.left + dx; }
        if (dir.includes('n')) { height = r.height - dy; top = r.top + dy; }
        width = Math.max(minW, width); height = Math.max(minH, height);
        win.style.width = width + 'px';
        win.style.height = height + 'px';
        win.style.left = left + 'px';
        win.style.top = top + 'px';
      };
      const up = () => {
        document.removeEventListener('pointermove', move);
        document.removeEventListener('pointerup', up);
      };
      document.addEventListener('pointermove', move);
      document.addEventListener('pointerup', up);
    });
  });
}

