<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=coverage">
<title>VibeCode — Lilly</title>
<style>
:root{
  --frost-bg:rgba(15,15,28,0.88);
  --frost-surface:rgba(255,255,255,0.06);
  --frost-border:rgba(255,255,255,0.10);
  --frost-glow:rgba(130,100,220,0.18);
  --accent:#a78bfa;
  --accent2:#818cf8;
  --green:#4ade80;
  --red:#f87171;
  --yellow:#fbbf24;
  --text:rgba(255,255,255,0.88);
  --text-dim:rgba(255,255,255,0.42);
  --radius:14px;
  --chat-w:380px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{
  background:#0b0b18;
  background-image:radial-gradient(ellipse at 20% 20%,rgba(88,60,160,0.22) 0%,transparent 55%),
                   radial-gradient(ellipse at 80% 80%,rgba(40,80,160,0.18) 0%,transparent 55%);
  color:var(--text);
  font-family:'Segoe UI',system-ui,-apple-system,sans-serif;
  height:100vh;overflow:hidden;
  display:flex;flex-direction:column;
}

/* ── Frost window base ── */
.frost{
  background:var(--frost-bg);
  backdrop-filter:blur(24px) saturate(1.4);
  -webkit-backdrop-filter:blur(24px) saturate(1.4);
  border:1px solid var(--frost-border);
  border-radius:var(--radius);
  box-shadow:0 8px 40px rgba(0,0,0,0.55),0 0 0 1px rgba(255,255,255,0.04) inset;
}

/* ── Top bar ── */
#topbar{
  display:flex;align-items:center;gap:12px;
  padding:10px 16px;
  background:rgba(10,10,22,0.92);
  border-bottom:1px solid var(--frost-border);
  flex-shrink:0;
  z-index:100;
}
#topbar .logo{font-size:15px;font-weight:700;color:var(--accent);letter-spacing:.5px;white-space:nowrap}
#topbar .logo span{color:var(--text-dim);font-weight:400}
#project-select{
  flex:1;max-width:260px;
  background:var(--frost-surface);
  border:1px solid var(--frost-border);
  color:var(--text);
  border-radius:9px;padding:6px 10px;font-size:13px;outline:none;
}
#project-select option{background:#1a1a2e;color:#fff}
.topbtn{
  background:var(--frost-surface);border:1px solid var(--frost-border);
  color:var(--text-dim);border-radius:9px;padding:6px 12px;
  font-size:12px;cursor:pointer;transition:all .2s;white-space:nowrap;
}
.topbtn:hover{background:rgba(167,139,250,0.15);color:var(--accent);border-color:rgba(167,139,250,0.3)}
.topbtn.danger:hover{background:rgba(248,113,113,0.15);color:var(--red);border-color:rgba(248,113,113,0.3)}
.topbtn.success{background:rgba(74,222,128,0.12);color:var(--green);border-color:rgba(74,222,128,0.3)}
#status-dot{width:8px;height:8px;border-radius:50%;background:var(--text-dim);flex-shrink:0;transition:background .3s}
#status-dot.running{background:var(--green);box-shadow:0 0 6px var(--green)}
#status-dot.building{background:var(--yellow);box-shadow:0 0 6px var(--yellow);animation:pulse .8s infinite}
#status-dot.error{background:var(--red);box-shadow:0 0 6px var(--red)}
#status-label{font-size:11px;color:var(--text-dim);white-space:nowrap}
#project-url{font-size:11px;color:var(--accent2);text-decoration:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:200px}
#project-url:hover{color:var(--accent)}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

/* ── Main layout ── */
#main{
  display:flex;flex:1;overflow:hidden;
  gap:0;
}

/* ── File manager sidebar ── */
#sidebar{
  width:220px;flex-shrink:0;
  display:flex;flex-direction:column;
  border-right:1px solid var(--frost-border);
  overflow:hidden;
  transition:width .25s ease;
}
#sidebar.collapsed{width:0;border-right:none}
#sidebar-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 12px;border-bottom:1px solid var(--frost-border);
  background:rgba(255,255,255,0.03);flex-shrink:0;
}
#sidebar-header span{font-size:11px;font-weight:600;color:var(--text-dim);letter-spacing:.5px;text-transform:uppercase}
#sidebar-header button{background:none;border:none;color:var(--text-dim);cursor:pointer;font-size:14px;padding:0 2px;line-height:1}
#sidebar-header button:hover{color:var(--accent)}
#file-tree{flex:1;overflow-y:auto;padding:6px 4px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.1) transparent}
.ftree-item{
  display:flex;align-items:center;gap:6px;
  padding:5px 8px;border-radius:8px;cursor:pointer;
  font-size:12px;color:var(--text);
  transition:background .15s;white-space:nowrap;overflow:hidden;
}
.ftree-item:hover{background:rgba(255,255,255,.06)}
.ftree-item.active{background:rgba(167,139,250,.18);color:var(--accent)}
.ftree-item .icon{font-size:13px;flex-shrink:0;width:16px;text-align:center}
.ftree-item .name{overflow:hidden;text-overflow:ellipsis;flex:1}
.ftree-item .size{font-size:10px;color:var(--text-dim);flex-shrink:0}
.ftree-dir{color:var(--accent2)}
.ftree-back{color:var(--text-dim);font-style:italic}

/* ── Editor area ── */
#editor-wrap{
  flex:1;display:flex;flex-direction:column;overflow:hidden;
  min-width:0;
}
#editor-tabs{
  display:flex;align-items:center;gap:0;
  background:rgba(255,255,255,.03);
  border-bottom:1px solid var(--frost-border);
  overflow-x:auto;flex-shrink:0;
  scrollbar-width:none;
}
#editor-tabs::-webkit-scrollbar{display:none}
.etab{
  display:flex;align-items:center;gap:6px;
  padding:8px 14px;font-size:12px;cursor:pointer;
  border-right:1px solid var(--frost-border);
  color:var(--text-dim);white-space:nowrap;
  transition:background .15s,color .15s;flex-shrink:0;
}
.etab:hover{background:rgba(255,255,255,.05);color:var(--text)}
.etab.active{background:rgba(167,139,250,.12);color:var(--accent);border-bottom:2px solid var(--accent)}
.etab .close{font-size:11px;padding:0 2px;border-radius:3px;opacity:.4}
.etab .close:hover{opacity:1;background:rgba(248,113,113,.2);color:var(--red)}
.etab .dirty{color:var(--yellow);font-size:10px}
#editor-toolbar{
  display:flex;align-items:center;gap:8px;
  padding:6px 12px;border-bottom:1px solid var(--frost-border);
  background:rgba(255,255,255,.02);flex-shrink:0;
}
#editor-toolbar .einfo{font-size:11px;color:var(--text-dim);flex:1}
#editor-toolbar button{
  background:var(--frost-surface);border:1px solid var(--frost-border);
  color:var(--text-dim);border-radius:7px;padding:4px 10px;font-size:11px;cursor:pointer;transition:all .2s;
}
#editor-toolbar button:hover{background:rgba(167,139,250,.15);color:var(--accent);border-color:rgba(167,139,250,.3)}
#editor-toolbar .save-btn.dirty{color:var(--yellow);border-color:rgba(251,191,36,.4)}
#editor-box{flex:1;position:relative;overflow:hidden}
#code-editor{
  width:100%;height:100%;
  background:transparent;border:none;outline:none;resize:none;
  color:var(--text);font-family:'JetBrains Mono','Fira Code','Cascadia Code',Consolas,monospace;
  font-size:13px;line-height:1.6;padding:16px;
  tab-size:2;
  scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.1) transparent;
}
#code-editor::selection{background:rgba(167,139,250,.28)}
#editor-placeholder{
  position:absolute;inset:0;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:12px;pointer-events:none;
}
#editor-placeholder .ph-icon{font-size:48px;opacity:.2}
#editor-placeholder .ph-text{font-size:13px;color:var(--text-dim);text-align:center;line-height:1.6}

/* ── Chat panel (frost window, right side) ── */
#chat-panel{
  width:var(--chat-w);flex-shrink:0;
  display:flex;flex-direction:column;
  border-left:1px solid var(--frost-border);
  transition:width .25s ease;
  overflow:hidden;
}
#chat-panel.reduced{width:48px}
#chat-panel.hidden{width:0;border-left:none}
#chat-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 12px;border-bottom:1px solid var(--frost-border);
  background:rgba(255,255,255,.03);flex-shrink:0;
}
#chat-header .title{font-size:12px;font-weight:600;color:var(--accent);letter-spacing:.3px;white-space:nowrap;overflow:hidden}
.chat-controls{display:flex;gap:4px;flex-shrink:0}
.chat-ctrl-btn{
  background:none;border:1px solid var(--frost-border);
  color:var(--text-dim);border-radius:7px;width:26px;height:26px;
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;font-size:13px;transition:all .2s;
}
.chat-ctrl-btn:hover{background:rgba(167,139,250,.15);color:var(--accent);border-color:rgba(167,139,250,.3)}
#chat-panel.reduced #chat-header .title{display:none}
#chat-panel.reduced .chat-ctrl-btn.non-reduce{display:none}
#chat-messages{
  flex:1;overflow-y:auto;padding:12px;
  display:flex;flex-direction:column;gap:8px;
  scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.1) transparent;
}
#chat-panel.reduced #chat-messages,
#chat-panel.reduced #chat-input-row,
#chat-panel.reduced #chat-context-bar{display:none}
.cmsg{border-radius:10px;padding:9px 12px;font-size:12px;line-height:1.55;max-width:100%;word-break:break-word}
.cmsg.user{background:rgba(167,139,250,.15);color:#c4b5fd;align-self:flex-end;margin-left:16px}
.cmsg.assistant{background:var(--frost-surface);color:var(--text);border:1px solid var(--frost-border)}
.cmsg.system{background:rgba(74,222,128,.08);color:rgba(74,222,128,.8);font-size:11px;font-style:italic;border:1px solid rgba(74,222,128,.15)}
.cmsg pre{background:rgba(0,0,0,.35);border-radius:6px;padding:8px;margin-top:6px;overflow-x:auto;font-size:11px}
.cmsg code{font-family:'JetBrains Mono',monospace;font-size:11px}
.apply-btn{
  margin-top:6px;background:rgba(167,139,250,.18);border:1px solid rgba(167,139,250,.3);
  color:var(--accent);border-radius:7px;padding:4px 10px;font-size:11px;cursor:pointer;transition:all .2s;
}
.apply-btn:hover{background:rgba(167,139,250,.3)}
#chat-context-bar{
  padding:6px 10px;border-bottom:1px solid var(--frost-border);
  background:rgba(255,255,255,.02);
  display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text-dim);
  flex-shrink:0;
}
#chat-context-bar .ctx-file{color:var(--accent2);font-family:monospace;font-size:10px;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#chat-context-bar input[type=checkbox]{accent-color:var(--accent)}
#chat-input-row{
  display:flex;align-items:flex-end;gap:8px;
  padding:10px 12px;border-top:1px solid var(--frost-border);
  background:rgba(255,255,255,.02);flex-shrink:0;
}
#chat-input{
  flex:1;background:var(--frost-surface);
  border:1px solid var(--frost-border);color:var(--text);
  border-radius:10px;padding:8px 12px;font-size:12px;
  resize:none;outline:none;min-height:36px;max-height:120px;
  font-family:inherit;line-height:1.5;
}
#chat-input:focus{border-color:rgba(167,139,250,.4)}
#chat-send{
  background:rgba(167,139,250,.22);border:1px solid rgba(167,139,250,.35);
  color:var(--accent);border-radius:10px;width:36px;height:36px;
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;font-size:16px;transition:all .2s;flex-shrink:0;
}
#chat-send:hover{background:rgba(167,139,250,.38)}

/* ── Reduced chat vertical icon ── */
#chat-panel.reduced{
  align-items:center;padding-top:0;
}
#reduce-icon{
  writing-mode:vertical-rl;font-size:11px;color:var(--accent);
  letter-spacing:.5px;padding:12px 0;cursor:pointer;
  display:none;
}
#chat-panel.reduced #reduce-icon{display:block}

/* ── Logs panel ── */
#logs-panel{
  height:0;overflow:hidden;border-top:1px solid var(--frost-border);
  transition:height .25s ease;flex-shrink:0;
  background:rgba(0,0,0,.35);
}
#logs-panel.open{height:180px}
#logs-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:5px 12px;border-bottom:1px solid var(--frost-border);
  background:rgba(255,255,255,.03);
}
#logs-header span{font-size:11px;color:var(--text-dim);font-weight:600;letter-spacing:.3px;text-transform:uppercase}
#logs-header button{background:none;border:none;color:var(--text-dim);cursor:pointer;font-size:13px;transition:color .2s}
#logs-header button:hover{color:var(--accent)}
#logs-content{
  height:calc(100% - 30px);overflow-y:auto;padding:8px 12px;
  font-family:'JetBrains Mono',monospace;font-size:11px;
  line-height:1.6;color:rgba(255,255,255,.65);
  white-space:pre-wrap;word-break:break-all;
  scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.1) transparent;
}

/* ── Repo drop overlay ── */
#drop-overlay{
  position:fixed;inset:0;
  background:rgba(10,10,22,.92);
  backdrop-filter:blur(8px);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:20px;z-index:200;
  transition:opacity .25s;
}
#drop-overlay.hidden{opacity:0;pointer-events:none}
#drop-zone{
  width:480px;max-width:90vw;
  border:2px dashed rgba(167,139,250,.4);
  border-radius:20px;
  padding:40px 32px;
  text-align:center;
  transition:all .2s;
  background:rgba(167,139,250,.05);
}
#drop-zone.drag-over{border-color:var(--accent);background:rgba(167,139,250,.12);transform:scale(1.02)}
#drop-zone .dz-icon{font-size:48px;margin-bottom:12px;opacity:.7}
#drop-zone .dz-title{font-size:18px;font-weight:700;color:var(--text);margin-bottom:6px}
#drop-zone .dz-sub{font-size:13px;color:var(--text-dim);margin-bottom:20px;line-height:1.5}
#repo-url-input{
  width:100%;background:var(--frost-surface);
  border:1px solid var(--frost-border);color:var(--text);
  border-radius:10px;padding:10px 14px;font-size:13px;outline:none;
  margin-bottom:10px;
}
#repo-url-input:focus{border-color:rgba(167,139,250,.5)}
#repo-url-input::placeholder{color:var(--text-dim)}
#clone-btn{
  width:100%;background:rgba(167,139,250,.22);
  border:1px solid rgba(167,139,250,.4);
  color:var(--accent);border-radius:10px;padding:10px;
  font-size:14px;font-weight:600;cursor:pointer;
  transition:all .2s;margin-bottom:10px;
}
#clone-btn:hover{background:rgba(167,139,250,.35)}
#clone-btn:disabled{opacity:.4;cursor:not-allowed}
.or-row{display:flex;align-items:center;gap:12px;margin:8px 0}
.or-line{flex:1;height:1px;background:var(--frost-border)}
.or-text{font-size:11px;color:var(--text-dim)}
#project-list-overlay{
  width:480px;max-width:90vw;
  display:flex;flex-direction:column;gap:6px;max-height:220px;overflow-y:auto;
  scrollbar-width:thin;
}
.proj-card{
  display:flex;align-items:center;gap:10px;
  padding:10px 14px;border-radius:12px;cursor:pointer;
  background:var(--frost-surface);border:1px solid var(--frost-border);
  transition:all .2s;
}
.proj-card:hover{background:rgba(167,139,250,.12);border-color:rgba(167,139,250,.3)}
.proj-card .pname{flex:1;font-size:13px;font-weight:600}
.proj-card .pstatus{font-size:10px;padding:2px 7px;border-radius:6px;font-weight:600}
.pstatus.running{background:rgba(74,222,128,.15);color:var(--green)}
.pstatus.stopped{background:rgba(255,255,255,.06);color:var(--text-dim)}
.pstatus.building{background:rgba(251,191,36,.12);color:var(--yellow)}
.proj-card .pport{font-size:10px;color:var(--text-dim)}
#skip-btn{
  background:none;border:1px solid var(--frost-border);
  color:var(--text-dim);border-radius:10px;padding:8px 20px;
  font-size:12px;cursor:pointer;transition:all .2s;
}
#skip-btn:hover{border-color:rgba(255,255,255,.25);color:var(--text)}
#clone-progress{font-size:12px;color:var(--text-dim);text-align:center;min-height:18px}

/* ── Toasts ── */
#toast-container{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:999;display:flex;flex-direction:column;gap:8px;align-items:center;pointer-events:none}
.toast{
  background:rgba(20,20,35,.92);border:1px solid var(--frost-border);
  color:var(--text);border-radius:10px;padding:9px 18px;
  font-size:12px;backdrop-filter:blur(12px);
  animation:toastIn .25s ease,toastOut .3s ease 2.7s forwards;
}
.toast.ok{border-color:rgba(74,222,128,.3);color:var(--green)}
.toast.err{border-color:rgba(248,113,113,.3);color:var(--red)}
@keyframes toastIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
@keyframes toastOut{to{opacity:0;transform:translateY(8px)}}

/* ── Template wizard cards ── */
.template-card{
  display:flex;flex-direction:column;gap:6px;
  padding:12px 14px;border-radius:12px;cursor:pointer;
  background:var(--frost-surface);border:1px solid var(--frost-border);
  transition:all .2s;
}
.template-card:hover{background:rgba(167,139,250,.12);border-color:rgba(167,139,250,.3)}
.template-card.selected{background:rgba(167,139,250,.18);border-color:rgba(167,139,250,.5)}
.template-card .t-title{
  font-size:13px;font-weight:600;color:var(--text);display:flex;align-items:center;gap:6px
}
.template-card .t-desc{
  font-size:11px;color:var(--text-dim);line-height:1.4
}
.template-card .t-tag{
  font-size:10px;color:var(--accent);background:rgba(167,139,250,.1);border:1px solid rgba(167,139,250,.2);border-radius:4px;padding:1px 6px;align-self:flex-start
}

/* ── Mobile responsive ── */
@media(max-width:768px){
  :root{--chat-w:100vw}
  #main{flex-direction:column}
  #sidebar{display:none}
  #editor-wrap{display:none}
  #chat-panel{width:100%!important;position:fixed!important;top:56px!important;right:0;bottom:0;left:0;border-left:none!important;z-index:500 !important}
  #chat-panel{padding-top:env(safe-area-inset-top,0);padding-bottom:env(safe-area-inset-bottom,0);padding-left:env(safe-area-inset-left,0);padding-right:env(safe-area-inset-right,0);box-sizing:border-box}
  #chat-header{padding-left:calc(12px + env(safe-area-inset-left,0));padding-right:calc(12px + env(safe-area-inset-right,0));padding-top:calc(10px + env(safe-area-inset-top,0))}
  #chat-input-row{padding:12px 14px calc(12px + env(safe-area-inset-bottom,0))!important;gap:8px}
  #chat-input{min-height:44px;font-size:14px;padding:10px 14px}
  #chat-send,#chat-mic{width:44px;height:44px;font-size:16px}
  #sections-bar{padding:8px 12px;border-bottom:1px solid var(--frost-border)}
  .section-btn{padding:8px 14px;font-size:12px}
  #project-window{min-width:90vw;min-height:60vh;left:5vw!important;top:calc(10vh + env(safe-area-inset-top,0))!important}
  #notif-dropdown{width:min(320px,90vw)!important;right:5vw!important}
  #topbar{padding:calc(8px + env(safe-area-inset-top,0)) 10px;gap:8px}
  #topbar .logo{font-size:13px}
  #project-select{max-width:160px;font-size:11px}
  .topbtn{padding:5px 8px;font-size:11px}
  .topbtn{min-height:40px;min-width:40px}
}
@media(max-width:480px){
  #chat-panel{font-size:11px}
  #chat-input-row{padding:12px 14px calc(12px + env(safe-area-inset-bottom,0))!important;gap:6px}
  #chat-input{padding:10px 12px;font-size:12px;min-height:40px}
  #chat-send,#chat-mic{width:40px;height:40px;font-size:13px}
  .cmsg{padding:7px 10px;font-size:11px}
  #drop-zone{width:95vw;padding:24px 16px}
  #drop-zone .dz-icon{font-size:36px}
  #drop-zone .dz-title{font-size:16px}
  #repo-url-input,#repo-name-input{font-size:12px;padding:8px 10px}
  #clone-btn{padding:8px 14px;font-size:12px}
   #notif-dropdown{width:calc(100vw - 20px)!important;right:10px!important;max-width:none!important}
  #dashboard-window{width:90vw;left:5vw;top:8vh;height:70vh}
  #dw-body{padding:12px;font-size:12px}
  #dw-body .dw-section h3{font-size:10px}
  #dw-body .dw-stat{font-size:11px}
  #dw-files .dw-file{font-size:9px}
}

/* ── Dashboard pop-out ── */
#dashboard-window{
  position:fixed;left:5vw;top:10vh;width:50vw;height:60vh;
  z-index:260;border-radius:16px;overflow:hidden;display:none;
}
#dw-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:8px 12px;border-bottom:1px solid var(--frost-border);
