<script>
// ── State ────────────────────────────────────────────────────────
let currentProject = null;   // slug
let currentFile    = null;   // relative path
let openTabs       = [];     // [{path, lang, dirty, content}]
let activeTab      = -1;
let lastAISuggestion = null; // last code block from chat
let statusPollTimer  = null;
let logsPollTimer    = null;
let logsOpen         = false;
let chatMode         = 'normal'; // 'normal' | 'reduced' | 'hidden' | 'fullscreen'
let cwd              = '';       // current directory in file tree
let _autosaveTimer   = null;     // debounced live-save timer
let _autosaveCount   = 0;

// ── Toast ────────────────────────────────────────────────────────
function toast(msg, type='') {
  const c = document.getElementById('toast-container');
  const el = document.createElement('div');
  el.className = 'toast' + (type ? ' '+type : '');
  el.textContent = msg;
  c.appendChild(el);
  setTimeout(() => el.remove(), 3200);
}

// ── Drop overlay ─────────────────────────────────────────────────
function openDropOverlay() {
  document.getElementById('drop-overlay').classList.remove('hidden');
  loadProjectListOverlay();
}
function closeDropOverlay() {
  document.getElementById('drop-overlay').classList.add('hidden');
  closeTemplateWizard();
}

// ── Template wizard ──────────────────────────────────────────────────
let selectedTemplate = null;
async function loadTemplates() {
  const el = document.getElementById('template-list');
  if (!el) return;
  try {
    const r = await fetch('/api/vibecode/templates');
    const d = await r.json();
    const templates = d.templates || [];
    if (!templates.length) {
      el.innerHTML = '<div style="font-size:12px;color:var(--text-dim);text-align:center;padding:20px">No templates available</div>';
      return;
    }
    el.innerHTML = '';
    templates.forEach(t => {
      const card = document.createElement('div');
      card.className = 'template-card';
      card.dataset.template = t.key;
      card.innerHTML = `
        <div class="t-title"><span>${t.title}</span><span class="t-tag">${t.key}</span></div>
        <div class="t-desc">${t.description}</div>
      `;
      card.onclick = () => selectTemplateCard(t.key);
      el.appendChild(card);
    });
  } catch(e) {
    el.innerHTML = '<div style="font-size:12px;color:var(--red);padding:20px;text-align:center">Failed to load templates</div>';
  }
}

function showTemplateWizard() {
  document.getElementById('drop-zone').style.display = 'none';
  document.getElementById('template-wizard').style.display = 'flex';
  document.getElementById('project-list-overlay').style.display = 'none';
  selectedTemplate = null;
  loadTemplates();
}

function closeTemplateWizard() {
  const wiz = document.getElementById('template-wizard');
  if (wiz) wiz.style.display = 'none';
  const dz = document.getElementById('drop-zone');
  if (dz) dz.style.display = 'block';
  document.getElementById('project-list-overlay').style.display = 'block';
}

function selectTemplateCard(key) {
  selectedTemplate = key;
  document.querySelectorAll('.template-card').forEach(c => {
    c.classList.toggle('selected', c.dataset.template === key);
  });
}

async function createFromSelectedTemplate() {
  if (!selectedTemplate) { toast('Select a template first', 'err'); return; }
  const name = document.getElementById('template-project-name').value.trim();
  const btn = document.getElementById('template-create-btn');
  btn.disabled = true;
  btn.textContent = 'Creating…';
  try {
    const r = await fetch('/api/vibecode/create', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ template: selectedTemplate, name: name })
    });
    const d = await r.json();
    if (!r.ok) { toast(d.error || 'Creation failed', 'err'); btn.disabled=false;btn.textContent='Create'; return; }
    toast('Created: ' + d.slug, 'ok');
    closeTemplateWizard();
    await refreshProjectSelect();
    await selectProject(d.slug);
    setTimeout(() => buildAndRunProject(d.slug), 500);
  } catch(e) { toast('Network error', 'err'); }
  btn.disabled = false; btn.textContent = 'Create';
}

async function buildAndRunProject(slug) {
  try {
    let r = await fetch('/api/vibecode/build', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({slug}) });
    let d = await r.json();
    if (!r.ok) { toast('Build failed: ' + (d.error||d.log?.slice(-200)||'unknown'), 'err'); return; }
    toast('Build complete', 'ok');
    r = await fetch('/api/vibecode/run', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({slug}) });
    d = await r.json();
    if (!r.ok) { toast('Run failed: ' + (d.error||'unknown'), 'err'); return; }
     toast('Running: ' + d.url, 'ok');
     openProjectPreview(slug);
   } catch(e) { toast('Build/run error: ' + e.message, 'err'); }
 }

function openProjectPreview(slug) {
  const win = document.getElementById('project-window');
  const frame = document.getElementById('pw-frame');
  const stream = document.getElementById('pw-stream');
  const loading = document.getElementById('pw-loading');
  // Serve the running container through the same-origin preview proxy so the
  // iframe reaches it from any public host (e.g. https://droolingwithsanity.ca)
  // regardless of the internal Docker port.
  const previewUrl = '/api/vibecode/preview/' + slug;
  document.getElementById('pw-title').textContent = '👁 ' + slug + ' — Live Preview';
  const urlEl = document.getElementById('pw-url');
  urlEl.href = previewUrl; urlEl.textContent = previewUrl; urlEl.style.display = 'inline-block';
  stream.style.display = 'none';
  frame.style.display = 'block';
  loading.style.display = 'flex';
  frame.src = 'about:blank';
  void frame.offsetWidth;
  frame.src = previewUrl;
  frame.onload = () => { loading.style.display = 'none'; };
  win.style.display = 'block';
  win.style.left = '10vw'; win.style.top = '10vh';
  win.style.width = '50vw'; win.style.height = '60vh';
  win.dataset.maximized = 'false';
}

function togglePreviewLogs(slug, frame, stream, loading) {
  if (stream.style.display === 'none') {
    stream.style.display = 'block'; frame.style.display = 'none';
    stream.textContent = 'Streaming logs for ' + slug + '\u2026\n';
    loading.style.display = 'flex';
    connectPreviewStream(slug, stream, loading);
  } else {
    stream.style.display = 'none'; frame.style.display = 'block';
    if (stream._ws) { try { stream._ws.close(); } catch(e) {} }
  }
}

// ── Preview window controls ───────────────────────────────────────────
function closeProjectWindow() {
  const win = document.getElementById('project-window');
  const frame = document.getElementById('pw-frame');
  if (frame) frame.src = 'about:blank';
  win.style.display = 'none';
  if (win.dataset) win.dataset.maximized = 'false';
}

function toggleProjectWindowSize() {
  const win = document.getElementById('project-window');
  if (win.dataset.maximized === 'true') {
    win.style.left = '10vw'; win.style.top = '10vh';
    win.style.width = '50vw'; win.style.height = '60vh';
    win.dataset.maximized = 'false';
  } else {
    win.style.left = '0'; win.style.top = '0';
    win.style.width = '90vw'; win.style.height = '90vh';
    win.dataset.maximized = 'true';
  }
}

function refreshProjectWindow() {
  const frame = document.getElementById('pw-frame');
  if (frame && frame.src && frame.style.display !== 'none') {
    frame.src = frame.src;
  } else {
    const slug = currentProject;
    if (slug && document.getElementById('project-window').style.display !== 'none') {
      openProjectPreview(slug);
    }
  }
}

function connectPreviewStream(slug, streamEl, loadingEl) {
  loadingEl.textContent = 'Streaming logs…';
  loadingEl.style.display = 'flex';
  const proto = location.protocol === 'https:' ? 'wss' : 'ws';
  const ws = new WebSocket(proto + '://' + location.host + '/api/vibecode/logs/ws/' + slug);
  streamEl._ws = ws;
  ws.onopen = () => { streamEl.textContent = ''; };
  ws.onmessage = (e) => {
    streamEl.textContent += e.data + '\n';
    streamEl.scrollTop = streamEl.scrollHeight;
  };
  ws.onclose = () => { if (streamEl._ws === ws) loadingEl.style.display = 'none'; };
  ws.onerror = () => { setTimeout(() => { if (streamEl._ws === ws) loadingEl.style.display = 'none'; }, 800); };
}

