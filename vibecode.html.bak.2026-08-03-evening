// ── File tree ─────────────────────────────────────────────────────
async function loadFileTree(path) {
  cwd = path || '';
  const tree = document.getElementById('file-tree');
  tree.innerHTML = '<div style="padding:10px 12px;font-size:11px;color:var(--text-dim)">Loading…</div>';
  document.getElementById('sidebar-title').textContent = cwd ? cwd.split('/').pop() : currentProject || 'Files';
  const upBtn = document.getElementById('nav-up-btn');
  upBtn.style.display = cwd ? '' : 'none';
  if (!currentProject) { tree.innerHTML = ''; return; }
  try {
    const r = await fetch('/api/vibecode/files/'+currentProject+'?path='+encodeURIComponent(cwd));
    const d = await r.json();
    if (d.error) { tree.innerHTML = '<div style="padding:8px 12px;color:var(--red);font-size:11px">'+d.error+'</div>'; return; }
    tree.innerHTML = '';
    if (cwd) {
      const back = document.createElement('div');
      back.className = 'ftree-item ftree-back';
      back.innerHTML = '<span class="icon">↑</span><span class="name">.. (parent)</span>';
      back.onclick = navigateUp;
      tree.appendChild(back);
    }
    (d.entries||[]).forEach(e => {
      const item = document.createElement('div');
      item.className = 'ftree-item' + (e.type==='dir' ? ' ftree-dir' : '');
      if (e.path === currentFile) item.classList.add('active');
      const icon = e.type==='dir' ? '📁' : fileIcon(e.name);
      const size = e.type==='file' && e.size > 0 ? formatSize(e.size) : '';
      item.innerHTML = `<span class="icon">${icon}</span><span class="name">${e.name}</span><span class="size">${size}</span>`;
      item.onclick = () => {
        if (e.type==='dir') loadFileTree(e.path);
        else openFile(e.path);
      };
      tree.appendChild(item);
    });
    if (!d.entries.length && !cwd) {
      tree.innerHTML = '<div style="padding:10px 12px;font-size:11px;color:var(--text-dim)">Empty project</div>';
    }
  } catch(e) { tree.innerHTML = '<div style="padding:8px 12px;color:var(--red);font-size:11px">Error loading files</div>'; }
}

function navigateUp() {
  if (!cwd) return;
  const parts = cwd.split('/');
  parts.pop();
  loadFileTree(parts.join('/'));
}

function fileIcon(name) {
  const ext = name.split('.').pop().toLowerCase();
  const m = {py:'🐍',js:'⚡',ts:'💙',jsx:'⚛',tsx:'⚛',html:'🌐',css:'🎨',json:'{}',
             yaml:'📄',yml:'📄',sh:'📜',md:'📝',txt:'📄',rs:'🦀',go:'🐹',
             java:'☕',cpp:'⚙',c:'⚙',sql:'🗄',Dockerfile:'🐳',env:'🔒'};
  if (name==='Dockerfile') return '🐳';
  return m[ext] || '📄';
}

function formatSize(b) {
  if (b < 1024) return b+'b';
  if (b < 1024*1024) return (b/1024).toFixed(1)+'k';
  return (b/1024/1024).toFixed(1)+'M';
}
