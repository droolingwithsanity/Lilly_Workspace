<script>
// ── Chat ──────────────────────────────────────────────────────────
function addSysMsg(text) {
  appendChatMsg('system', text, false);
  appendFsChatMsg('system', text);
}

function appendChatMsg(role, content, isFull) {
  const container = document.getElementById(isFull ? 'chat-fs-messages' : 'chat-messages');
  const div = document.createElement('div');
  div.className = 'cmsg '+role;
  div.innerHTML = renderMarkdown(content);
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
}

function appendFsChatMsg(role, content) {
  appendChatMsg(role, content, true);
}

function renderMarkdown(text) {
  // Minimal: fenced code blocks, inline code, bold
  let out = escHtml(text);
  // fenced code blocks
  out = out.replace(/```(\w+)?\n([\s\S]*?)```/g, (_, lang, code) => {
    const l = lang || '';
    return `<pre><code class="lang-${l}">${code.trimEnd()}</code></pre>`;
  });
  // inline code
  out = out.replace(/`([^`]+)`/g, '<code>$1</code>');
  // bold
  out = out.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  // newlines
  out = out.replace(/\n/g, '<br>');
  return out;
}

function escHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

async function sendChat() {
  const input = document.getElementById('chat-input');
  const msg = input.value.trim();
  if (!msg) return;
  input.value = ''; autoResize(input);
  appendChatMsg('user', msg, false);
  appendFsChatMsg('user', msg);
  await _doChat(msg);
}

async function sendFsChat() {
  const input = document.getElementById('chat-fs-input');
  const msg = input.value.trim();
  if (!msg) return;
  input.value = '';
  appendChatMsg('user', msg, false);
  appendFsChatMsg('user', msg);
  await _doChat(msg);
}

async function _doChat(msg) {
  const includeFile = document.getElementById('ctx-include-file').checked;
  const fileContent = (includeFile && activeTab >= 0) ? openTabs[activeTab].content : '';
  const thinking = appendThinking();
  try {
    const r = await fetch('/api/vibecode/chat', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ slug: currentProject||'', message: msg, file: fileContent })
    });
    const d = await r.json();
    removeThinking(thinking);
    if (!r.ok) { appendChatMsg('system','Error: '+(d.error||'unknown')+'',false); appendFsChatMsg('system',d.error||'Error'); return; }

    // ── Dashboard pop-out ──
    if (d.action === 'dashboard_open' && d.dashboard_data) {
      populateDashboard(d.dashboard_data);
      openDashboard();
      appendChatMsgWithApply('assistant', d.reply || 'Opening dashboard…');
      return;
    }

    const reply = d.reply || '';
    appendChatMsgWithApply('assistant', reply);
    // Store last code block for apply button
    if (d.code_blocks && d.code_blocks.length) {
      lastAISuggestion = d.code_blocks[0].code;
      document.getElementById('apply-ai-btn').style.display = activeTab>=0 ? '' : 'none';
    }
  } catch(e) {
    removeThinking(thinking);
    appendChatMsg('system','Network error',false);
  }
}

function appendThinking() {
  const c = document.getElementById('chat-messages');
  const el = document.createElement('div');
  el.className = 'cmsg assistant';
  el.innerHTML = '<span style="color:var(--text-dim);animation:pulse 1s infinite">Lilly is thinking…</span>';
  c.appendChild(el);
  c.scrollTop = c.scrollHeight;
  return el;
}
function removeThinking(el) { if (el && el.parentNode) el.parentNode.removeChild(el); }

function appendChatMsgWithApply(role, content) {
  const c = document.getElementById('chat-messages');
  const div = document.createElement('div');
  div.className = 'cmsg '+role;
  div.innerHTML = renderMarkdown(content);
  // Add apply buttons for each code block in the response
  const re = /```(\w+)?\n([\s\S]*?)```/g;
  let m; let idx = 0;
  while ((m = re.exec(content)) !== null) {
    const code = m[2].trim();
    const btn = document.createElement('button');
    btn.className = 'apply-btn';
    btn.textContent = '✨ Apply to editor';
    btn.onclick = () => applyCodeToEditor(code);
    div.appendChild(btn);
    idx++;
  }
  c.appendChild(div);
  c.scrollTop = c.scrollHeight;
  // Mirror to fullscreen chat
  appendFsChatMsg(role, content);
}

function applyAISuggestion() {
  if (!lastAISuggestion) return;
  applyCodeToEditor(lastAISuggestion);
}

function applyCodeToEditor(code) {
  if (activeTab < 0) { toast('Open a file first','err'); return; }
  const editor = document.getElementById('code-editor');
  // Replace selected text or append
  const s = editor.selectionStart, e2 = editor.selectionEnd;
  if (s !== e2) {
    openTabs[activeTab].content = editor.value.substring(0,s) + code + editor.value.substring(e2);
  } else {
    openTabs[activeTab].content = code;
  }
  openTabs[activeTab].dirty = true;
  editor.value = openTabs[activeTab].content;
  renderTabs();
  document.getElementById('save-btn').classList.add('dirty');
  toast('Applied to editor','ok');
}

function askAboutFile() {
  if (activeTab < 0) return;
  const tab = openTabs[activeTab];
  document.getElementById('chat-input').value = 'Explain this file: '+tab.path;
  if (chatMode === 'hidden') expandChat();
  sendChat();
}

// ── Chat panel controls ───────────────────────────────────────────
function toggleChat() {
  if (chatMode === 'hidden') expandChat();
  else hideChat();
}
function reduceChat() {
  chatMode = 'reduced';
  document.getElementById('chat-panel').className = 'frost reduced';
  document.getElementById('chat-panel').style.borderRadius = '0';
}
function expandChat() {
  chatMode = 'normal';
  document.getElementById('chat-panel').className = 'frost';
  document.getElementById('chat-panel').style.cssText = 'border-radius:0';
}
function expandChatIfCollapsed() {
  if (chatMode === 'hidden') expandChat();
}
function hideChat() {
  chatMode = 'hidden';
  document.getElementById('chat-panel').className = 'frost hidden';
  document.getElementById('chat-panel').style.borderRadius = '0';
}
function chatFullscreen() {
  chatMode = 'fullscreen';
  const el = document.getElementById('chat-fullscreen');
  el.style.display = 'flex';
  document.getElementById('chat-fs-messages').scrollTop = 9999;
}
function exitFullscreen() {
  chatMode = 'normal';
  document.getElementById('chat-fullscreen').style.display = 'none';
}

function chatKeydown(e) {
  if (e.key==='Enter' && !e.shiftKey) { e.preventDefault(); sendChat(); }
}
function fsChatKeydown(e) {
  if (e.key==='Enter' && !e.shiftKey) { e.preventDefault(); sendFsChat(); }
}
function autoResize(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 120)+'px';
}

// ── Drag & drop URL onto drop-zone ───────────────────────────────
const dz = document.getElementById('drop-zone');
dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('drag-over'); });
dz.addEventListener('dragleave', () => dz.classList.remove('drag-over'));
dz.addEventListener('drop', e => {
  e.preventDefault(); dz.classList.remove('drag-over');
  const text = e.dataTransfer.getData('text/plain').trim();
  if (text) { document.getElementById('repo-url-input').value = text; }
});

// ── repo-url-input: enter key → clone ──────────────────────────
document.getElementById('repo-url-input').addEventListener('keydown', e => {
  if (e.key === 'Enter') { e.preventDefault(); cloneRepo(); }
});

// ── Init ─────────────────────────────────────────────────────────
(async function init() {
  await refreshProjectSelect();
  await loadProjectListOverlay();
  // Auto-open first running project if any
  try {
    const r = await fetch('/api/vibecode/projects');
    const d = await r.json();
    const running = (d.projects||[]).find(p => p.status === 'running');
    const first   = (d.projects||[])[0];
    const auto    = running || first;
    if (auto) {
      // Don't auto-open, just pre-fill the select — let user decide
      document.getElementById('project-select').value = auto.slug;
    } else {
      // No projects yet → show overlay
      openDropOverlay();
    }
  } catch(e) {
    openDropOverlay();
  }
})();
</script>
</body>
</html>
