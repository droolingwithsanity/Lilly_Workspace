<!-- ── Project preview window (live container UI + logs) ── -->
<div id="project-window" class="frost" style="display:none;position:fixed;left:10vw;top:10vh;width:50vw;height:60vh;z-index:250;border-radius:16px;overflow:hidden">
  <div id="pw-header" style="display:flex;align-items:center;justify-content:space-between;padding:6px 12px;border-bottom:1px solid var(--frost-border);background:rgba(255,255,255,.03)">
    <span id="pw-title" style="font-size:12px;font-weight:600;color:var(--accent);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1;min-width:0"></span>
    <a id="pw-url" href="#" target="_blank" style="font-size:10px;color:var(--accent2);text-decoration:none;overflow:hidden;text-overflow:ellipsis;max-width:160px;display:none;margin:0 8px"></a>
    <div style="display:flex;gap:4px;flex-shrink:0">
      <button class="topbtn" id="pw-log-btn" onclick="togglePreviewLogs(currentProject, document.getElementById('pw-frame'), document.getElementById('pw-stream'), document.getElementById('pw-loading'))" title="Toggle logs">📋</button>
      <button class="topbtn" onclick="refreshProjectWindow()" title="Refresh">↻</button>
